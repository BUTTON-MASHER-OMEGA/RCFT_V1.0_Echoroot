def run_SIM13_6(
    n_seeds=100,
    n_boot=5000,
    cfg=CFG,
    progress=True,
):
    print()
    print(
        "=" * 112
    )

    print(
        "SIM13.6 — MEMORY-TIMESCALE "
        "SCALING TEST / SIM13 CLOSURE"
    )

    print(
        "=" * 112
    )

    print(
        f"beta={cfg.beta}, "
        f"lambda={cfg.lam}, "
        f"T_tol={cfg.Ttol}"
    )

    print(
        f"burnin={cfg.burnin}, "
        f"reference={cfg.reference}, "
        f"observation={cfg.observation}"
    )

    print(
        f"diagnostic_every="
        f"{cfg.diagnostic_every}, "
        f"stats_window="
        f"{cfg.stats_window}"
    )

    print(
        f"seeds per delta={n_seeds}, "
        f"bootstrap resamples per delta={n_boot}"
    )

    print(
        f"deltas={cfg.deltas}"
    )

    print(
        f"common offsets={cfg.offsets}"
    )

    print()

    print(
        "Primary question: does the population "
        "sign-crossing scale move as predicted by memory?"
    )

    print(
        "SIM13.6 is the final SIM13 experiment. "
        "New mechanisms belong to SIM14."
    )

    # IMPORTANT:
    # Predictions are emitted before
    # any trajectory generation.
    print_frozen_predictions(
        cfg
    )

    results_by_delta = {}

    for d in cfg.deltas:
        results_by_delta[d] = (
            run_delta_condition(
                d,
                n_seeds=n_seeds,
                n_boot=n_boot,
                base_cfg=cfg,
                progress=progress,
            )
        )

        print_delta_response_table(
            results_by_delta[d]
        )

        print_basin_table(
            results_by_delta[d]
        )

    # --------------------------------------------------------------
    # SIM13.5 implementation-lineage gate.
    # --------------------------------------------------------------

    anchor_result = (
        results_by_delta[
            SIM135_DELTA_ANCHOR
        ]
    )

    anchor_sc = (
        anchor_result[
            "crossover"
        ][
            "s_c"
        ]
        if anchor_result[
            "crossover"
        ][
            "exists"
        ]
        else np.nan
    )

    anchor_reproduced = (
        inside_ci(
            anchor_sc,
            SIM135_CI95,
        )
    )

    print()
    print(
        "=" * 112
    )

    print(
        "SIM13.5 LINEAGE GATE"
    )

    print(
        "=" * 112
    )

    print(
        "Archived SIM13.5 s_c                : "
        f"{SIM135_SC_ANCHOR:.6f}"
    )

    print(
        "Archived SIM13.5 95% CI             : "
        f"[{SIM135_CI95[0]:.6f}, "
        f"{SIM135_CI95[1]:.6f}]"
    )

    print(
        "SIM13.6 delta=.95 observed s_c       : "
        f"{anchor_sc:.6f}"
    )

    print(
        "delta=.95 reproduction PASS          : "
        f"{anchor_reproduced}"
    )

    if not anchor_reproduced:
        print()
        print(
            "LINEAGE WARNING:"
        )

        print(
            "The delta=.95 anchor did not reproduce "
            "the archived SIM13.5 interval."
        )

        print(
            "Scaling interpretation is blocked until "
            "implementation lineage is checked."
        )

    evaluation = (
        evaluate_scaling(
            results_by_delta,
            cfg,
        )
    )

    # The historical-anchor reproduction
    # is an additional hard promotion gate.
    if not anchor_reproduced:
        evaluation[
            "H_delta_pass"
        ] = False

        evaluation[
            "H_M_pass"
        ] = False

    print_scaling_table(
        evaluation
    )

    print_hypothesis_decision(
        evaluation,
        cfg,
    )

    H_delta = (
        evaluation[
            "H_delta_pass"
        ]
    )

    H_M = (
        evaluation[
            "H_M_pass"
        ]
    )

    all_cross = (
        evaluation[
            "all_crossovers_exist"
        ]
    )

    print()
    print(
        "=" * 112
    )

    print(
        "SIM13.6 TRUTH-PACKET STATUS / "
        "SIM13 CLOSURE"
    )

    print(
        "=" * 112
    )

    if not anchor_reproduced:
        status = (
            "LINEAGE FAILURE"
        )

        truth = (
            "The SIM13.5 anchor did not reproduce "
            "under SIM13.6, so no memory-timescale "
            "scaling claim is promoted."
        )

    elif not all_cross:
        status = (
            "CROSSOVER DOMAIN FAILURE"
        )

        truth = (
            "The biphasic crossover does not persist "
            "across the full delta panel; the phenomenon "
            "has a restricted parameter domain or loses "
            "definition."
        )

    elif (
        H_delta
        and not H_M
    ):
        status = (
            "BARE-DECAY SCALING SUPPORTED"
        )

        truth = (
            "The outer crossover scales quantitatively "
            "with the bare memory-decay timescale across "
            "held-out delta values."
        )

    elif (
        H_M
        and not H_delta
    ):
        status = (
            "REALIZED-MEMORY SCALING SUPPORTED"
        )

        truth = (
            "The outer crossover is organized more "
            "consistently by the realized native memory "
            "correlation timescale than by the bare decay "
            "coefficient."
        )

    elif (
        H_delta
        and H_M
