# 22. FROZEN-PREDICTION / MODEL-COMPARISON LOGIC
# ======================================================================

def bare_prediction(
    delta,
):
    return (
        R_DELTA_FROZEN
        * tau_delta(delta)
    )


def inside_ci(
    value,
    ci,
):
    return (
        np.isfinite(value)
        and np.isfinite(
            ci[0]
        )
        and np.isfinite(
            ci[1]
        )
        and (
            ci[0]
            <= value
            <= ci[1]
        )
    )


def monotonic_increasing(
    values,
):
    arr = np.asarray(
        values,
        dtype=float,
    )

    if not np.all(
        np.isfinite(arr)
    ):
        return False

    return bool(
        np.all(
            np.diff(arr) > 0
        )
    )


def evaluate_scaling(
    results_by_delta,
    cfg=CFG,
):
    deltas = list(
        cfg.deltas
    )

    anchor = (
        SIM135_DELTA_ANCHOR
    )

    heldout = [
        d
        for d in deltas
        if abs(
            d - anchor
        ) > 1e-12
    ]

    anchor_result = (
        results_by_delta[
            anchor
        ]
    )

    anchor_tauM = (
        anchor_result[
            "memory"
        ][
            "median"
        ]
    )

    if (
        np.isfinite(
            anchor_tauM
        )
        and anchor_tauM > 0
    ):
        r_M = (
            SIM135_SC_ANCHOR
            / anchor_tauM
        )

    else:
        r_M = np.nan

    rows = []

    for d in deltas:
        res = (
            results_by_delta[d]
        )

        sc_obs = (
            res[
                "crossover"
            ][
                "s_c"
            ]
            if res[
                "crossover"
            ][
                "exists"
            ]
            else np.nan
        )

        ci = (
            res[
                "bootstrap"
            ][
                "ci95"
            ]
        )

        pred_delta = (
            bare_prediction(d)
        )

        pred_M = (
            r_M
            * res[
                "memory"
            ][
                "median"
            ]
            if np.isfinite(r_M)
            else np.nan
        )

        if (
            np.isfinite(
                sc_obs
            )
            and sc_obs != 0
        ):
            rel_delta = (
                abs(
                    sc_obs
                    - pred_delta
                )
                / abs(sc_obs)
            )

            rel_M = (
                abs(
                    sc_obs
                    - pred_M
                )
                / abs(sc_obs)
                if np.isfinite(
                    pred_M
                )
                else np.nan
            )

        else:
            rel_delta = np.nan
            rel_M = np.nan

        rows.append(
            {
                "delta":
                    d,
                "tau_delta":
                    tau_delta(d),
                "half_life":
                    half_life_delta(d),
                "tau_M":
                    res[
                        "memory"
                    ][
                        "median"
                    ],
                "sc_obs":
                    sc_obs,
                "ci95":
                    ci,
                "pred_delta":
                    pred_delta,
                "pred_M":
                    pred_M,
                "err_delta":
                    (
                        sc_obs
                        - pred_delta
                        if np.isfinite(
                            sc_obs
                        )
                        else np.nan
                    ),
                "err_M":
                    (
                        sc_obs
                        - pred_M
                        if (
                            np.isfinite(
                                sc_obs
                            )
                            and np.isfinite(
                                pred_M
                            )
                        )
                        else np.nan
                    ),
                "rel_delta":
                    rel_delta,
                "rel_M":
                    rel_M,
                "capture_delta":
                    inside_ci(
                        pred_delta,
                        ci,
                    ),
                "capture_M":
                    inside_ci(
                        pred_M,
                        ci,
                    ),
                "s60":
                    (
                        res["s60"][
                            "s60"
                        ]
                        if res[
                            "s60"
                        ][
                            "exists"
                        ]
                        else np.nan
                    ),
            }
        )

    held_rows = [
        r
        for r in rows
        if r["delta"] in heldout
    ]

    all_crossovers_exist = all(
        results_by_delta[d][
            "crossover"
        ][
            "exists"
        ]
        for d in deltas
    )

    all_controls_pass = all(
        (
            results_by_delta[d][
                "zero_pass"
            ]
            and results_by_delta[d][
                "chronology"
            ][
                "passed"
            ]
            and results_by_delta[d][
                "identity_pass"
            ]
            and results_by_delta[d][
                "bootstrap_pass"
            ]
        )
        for d in deltas
    )

    observed_sc = [
        next(
            r["sc_obs"]
            for r in rows
            if r["delta"] == d
        )
        for d in deltas
    ]

    observed_monotonic = (
        monotonic_increasing(
            observed_sc
        )
    )

    delta_rel_pass = all(
        (
            np.isfinite(
                r["rel_delta"]
            )
            and (
                r["rel_delta"]
                <= cfg.relative_error_threshold
            )
        )
        for r in held_rows
    )

    M_rel_pass = all(
        (
            np.isfinite(
                r["rel_M"]
            )
            and (
                r["rel_M"]
                <= cfg.relative_error_threshold
            )
        )
        for r in held_rows
    )

    delta_captures = sum(
        bool(
            r["capture_delta"]
        )
        for r in held_rows
    )

    M_captures = sum(
        bool(
            r["capture_M"]
        )
        for r in held_rows
    )

    delta_ci_pass = (
        delta_captures
        >= cfg.min_ci_captures
    )

    M_ci_pass = (
        M_captures
        >= cfg.min_ci_captures
    )

    H_delta_pass = (
        all_controls_pass
        and all_crossovers_exist
        and observed_monotonic
        and delta_rel_pass
        and delta_ci_pass
    )

    H_M_pass = (
        all_controls_pass
        and all_crossovers_exist
        and observed_monotonic
        and np.isfinite(r_M)
        and M_rel_pass
        and M_ci_pass
    )

    mae_delta = mean_value(
        [
            abs(
                r["err_delta"]
            )
            for r in held_rows
        ]
    )

    mae_M = mean_value(
        [
            abs(
                r["err_M"]
            )
            for r in held_rows
        ]
    )

    return {
        "rows":
            rows,
        "heldout":
            heldout,
        "r_M":
            r_M,
        "all_crossovers_exist":
            all_crossovers_exist,
        "all_controls_pass":
            all_controls_pass,
        "observed_monotonic":
            observed_monotonic,
        "delta_rel_pass":
            delta_rel_pass,
        "M_rel_pass":
            M_rel_pass,
        "delta_captures":
            delta_captures,
        "M_captures":
            M_captures,
        "delta_ci_pass":
            delta_ci_pass,
        "M_ci_pass":
            M_ci_pass,
        "H_delta_pass":
            H_delta_pass,
        "H_M_pass":
            H_M_pass,
        "mae_delta":
            mae_delta,
        "mae_M":
            mae_M,
    }


