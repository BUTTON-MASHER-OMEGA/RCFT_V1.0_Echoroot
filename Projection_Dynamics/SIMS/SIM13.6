def empirical_memory_summary(
    runs,
):
    taus = np.asarray(
        [
            run[
                "memory_timescale"
            ]["tau"]
            for run in runs
        ],
        dtype=float,
    )

    finite = taus[
        np.isfinite(taus)
    ]

    return {
        "taus":
            taus,
        "finite_fraction":
            (
                float(
                    len(finite)
                    / len(taus)
                )
                if len(taus)
                else np.nan
            ),
        "median":
            median_value(
                finite
            ),
        "iqr":
            iqr_value(
                finite
            ),
    }


def max_kappa_identity_error(
    runs,
    cfg=CFG,
):
    vals = []

    for run in runs:
        for s in cfg.offsets:
            for x in range(4):
                vals.append(
                    run["offsets"][s][x][
                        "kappa_identity_error"
                    ]
                )

    arr = finite_array(
        vals
    )

    return (
        float(
            np.max(arr)
        )
        if len(arr)
        else np.nan
    )


# ======================================================================
# 21. RUN ONE DELTA CONDITION
# ======================================================================

def run_delta_condition(
    delta,
    n_seeds=100,
    n_boot=5000,
    base_cfg=CFG,
    progress=True,
):
    cfg = replace(
        base_cfg,
        delta=float(delta),
    )

    runs = []
    zero_max = []

    print()
    print(
        "=" * 100
    )
    print(
        f"DELTA CONDITION: "
        f"delta={delta:.2f}"
    )
    print(
        "=" * 100
    )

    for seed in range(
        1,
        n_seeds + 1,
    ):
        result = simulate_seed(
            seed,
            cfg,
        )

        runs.append(
            result
        )

        zero_max.append(
            result[
                "zero_validation"
            ][
                "max_difference"
            ]
        )

        if (
            progress
            and (
                seed == 1
                or seed % 10 == 0
                or seed == n_seeds
            )
        ):
            print(
                f"delta={delta:.2f} | "
                f"completed seed "
                f"{seed:3d}/{n_seeds}"
            )

    zero_pass = all(
        run[
            "zero_validation"
        ][
            "passed"
        ]
        for run in runs
    )

    chronology = (
        chronology_summary(
            runs,
            cfg,
        )
    )

    identity_max = (
        max_kappa_identity_error(
            runs,
            cfg,
        )
    )

    identity_pass = (
        np.isfinite(
            identity_max
        )
        and (
            identity_max
            <= cfg.kappa_identity_tolerance
        )
    )

    response = (
        response_matrices(
            runs,
            cfg,
        )
    )

    diag = (
        diagnostic_summary(
            runs,
            cfg,
        )
    )

    median_outer = (
        np.nanmedian(
            response["outer"],
            axis=0,
        )
    )

    crossover = (
        estimate_crossover(
            response["offsets"],
            median_outer,
        )
    )

    boot = (
        bootstrap_crossover(
            response,
            n_boot=n_boot,
            seed=(
                136000
                + int(
                    round(
                        1000
                        * delta
                    )
                )
            ),
        )
    )

    bootstrap_pass = (
        boot[
            "finite_fraction"
        ]
        >= cfg.bootstrap_finite_threshold
    )

    s60 = estimate_s60(
        response,
        threshold=(
            cfg.majority_threshold
        ),
    )

    mem = (
        empirical_memory_summary(
            runs
        )
    )

    print()
    print(
        "CONTROL SUMMARY"
    )

    print(
        "Exact s=0 replay all seeds       : "
        f"{zero_pass}"
    )

    print(
        "Maximum s=0 diagnostic difference: "
        f"{max(zero_max):.3e}"
    )

    print(
        "Kernel chronology PASS           : "
        f"{chronology['passed']}"
    )

    print(
        "Max rho1(K) window difference    : "
        f"{chronology['max_difference']:.9f}"
    )

    print(
        "kappa=1-phi identity PASS        : "
        f"{identity_pass}"
    )

    print(
        "Maximum identity error           : "
        f"{identity_max:.3e}"
    )

    print(
        "Empirical-memory finite fraction : "
        f"{mem['finite_fraction']:.3f}"
    )

    print(
        "Empirical tau_M median / IQR     : "
        f"{mem['median']:.6f} / "
        f"{mem['iqr']:.6f}"
    )

    print()
    print(
        "PRIMARY CROSSOVER"
    )

    print(
        "Finite s_c                       : "
        f"{crossover['exists']}"
    )

    print(
        "Estimator status                 : "
        f"{crossover['reason']}"
    )

    if crossover["exists"]:
        print(
            "Observed s_c                     : "
            f"{crossover['s_c']:.6f}"
        )

        print(
            "Interpolation bracket            : "
            f"{crossover['s_minus']:.0f} -> "
            f"{crossover['s_plus']:.0f}"
        )

        print(
            "Positive confirmation pair       : "
            f"{crossover['positive_pair']}"
        )

    print(
        "Bootstrap finite fraction        : "
        f"{boot['finite_fraction']:.3f}"
    )

    if np.isfinite(
        boot["median"]
    ):
        print(
            "Bootstrap median s_c             : "
            f"{boot['median']:.6f}"
        )

        print(
            "Bootstrap 95% CI                 : "
            f"[{boot['ci95'][0]:.6f}, "
            f"{boot['ci95'][1]:.6f}]"
        )

    print(
        "Bootstrap validity PASS          : "
        f"{bootstrap_pass}"
    )

    print()
    print(
        "SECONDARY DISTRIBUTED TRANSITION"
    )

    print(
        "s_60 exists                      : "
        f"{s60['exists']}"
    )

    if s60["exists"]:
        print(
            "s_60                              : "
            f"{s60['s60']:.0f}"
        )

        print(
            "majority confirmation pair       : "
            f"{s60['pair']}"
        )

    return {
        "delta":
            float(delta),
        "cfg":
            cfg,
        "runs":
            runs,
        "response":
            response,
        "diagnostics":
            diag,
        "chronology":
            chronology,
        "identity_max":
            identity_max,
        "identity_pass":
            identity_pass,
        "zero_pass":
            zero_pass,
        "zero_max":
            max(zero_max),
        "crossover":
            crossover,
        "bootstrap":
            boot,
        "bootstrap_pass":
            bootstrap_pass,
        "s60":
            s60,
        "memory":
            mem,
    }


