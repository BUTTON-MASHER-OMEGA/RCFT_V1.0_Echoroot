import numpy as np
import math
from collections import defaultdict
from dataclasses import dataclass
import itertools

# ============================================================
# 1. CONFIGURATION
# ============================================================

@dataclass
class Config:
    lam: float
    delta: float
    beta: float
    alpha: float = 1.0
    T_tol: float = 1.0
    memory_sign: int = -1  # reinforce
    sat_mode: str = "tanh"
    seed: int = 1
    num_steps: int = 2000


# ============================================================
# 2. GRAPH + PROJECTION
# ============================================================

states = list(range(8))

proj_structured = {
    0: 0, 1: 0,  # basin A
    2: 1, 3: 1,  # basin B
    4: 2, 5: 2,  # basin C
    6: 3, 7: 3,  # basin D
}

neighbors = {
    0: [1, 3, 6],
    1: [0, 2],
    2: [1, 3, 4],
    3: [0, 2],
    4: [5, 7, 2],
    5: [4, 6],
    6: [5, 7, 0],
    7: [4, 6],
}

basins = {
    0: [0, 1],  # A
    1: [2, 3],  # B
    2: [4, 5],  # C
    3: [6, 7],  # D
}


# ============================================================
# 3. MEMORY SATURATION
# ============================================================

def saturate_memory(M, mode="tanh"):
    if mode == "tanh":
        return np.tanh(M)
    elif mode == "frac":
        return M / (1.0 + M) if M > 0 else 0.0
    else:
        return M


# ============================================================
# 4. FRICTION + TRANSITION PROBABILITIES
# ============================================================

def friction(u_i, u_j, mem_weights, cfg: Config, proj_map):
    d_graph = 1.0
    delta_proj = 0.0 if proj_map[u_i] == proj_map[u_j] else 1.0
    M_raw = mem_weights[(u_i, u_j)]
    M_sat = saturate_memory(M_raw, mode=cfg.sat_mode)
    return cfg.alpha + cfg.beta * delta_proj + cfg.memory_sign * cfg.lam * M_sat


def transition_probs(u_i, mem_weights, cfg: Config, proj_map):
    nbrs = neighbors[u_i]
    costs = np.array([friction(u_i, u_j, mem_weights, cfg, proj_map) for u_j in nbrs])
    weights = np.exp(-costs / cfg.T_tol)
    return nbrs, weights / weights.sum()


# ============================================================
# 5. SIMULATION ENGINE
# ============================================================

def simulate(cfg: Config, proj_map=None):
    if proj_map is None:
        proj_map = proj_structured

    rng = np.random.default_rng(cfg.seed)
    mem_weights = defaultdict(float)

    u = 0
    hidden = [u]
    obs = [proj_map[u]]
    edge_counts = defaultdict(int)

    for _ in range(cfg.num_steps):
        nbrs, probs = transition_probs(u, mem_weights, cfg, proj_map)
        u_next = rng.choice(nbrs, p=probs)

        # memory update
        for key in list(mem_weights.keys()):
            mem_weights[key] *= cfg.delta
            if mem_weights[key] < 1e-12:
                del mem_weights[key]
        mem_weights[(u, u_next)] += 1.0

        edge_counts[(u, u_next)] += 1

        u = u_next
        hidden.append(u)
        obs.append(proj_map[u])

    return np.array(hidden), np.array(obs), dict(edge_counts)


# ============================================================
# 6. METRICS (GLOBAL)
# ============================================================

def entropy(p):
    p = np.array(p, dtype=float)
    p = p[p > 0]
    return -np.sum(p * np.log(p)) if len(p) else 0.0


def compute_edge_entropy(edge_counts):
    total = sum(edge_counts.values())
    if total == 0:
        return 0.0
    p = [c / total for c in edge_counts.values()]
    return entropy(p)


def compute_conditional_entropy(hidden):
    trans_counts = defaultdict(int)
    from_counts = defaultdict(int)

    for i in range(len(hidden) - 1):
        u, v = hidden[i], hidden[i+1]
        trans_counts[(u, v)] += 1
        from_counts[u] += 1

    H = 0.0
    total = len(hidden) - 1
    if total <= 0:
        return 0.0

    for (u, v), c in trans_counts.items():
        p_uv = c / total
        p_v_given_u = c / from_counts[u]
        H -= p_uv * math.log(p_v_given_u + 1e-12)
    return H


def compute_dwell_time(obs):
    dwell = []
    cur = obs[0]
    length = 1
    for x in obs[1:]:
        if x == cur:
            length += 1
        else:
            dwell.append(length)
            cur = x
            length = 1
    dwell.append(length)
    return float(np.mean(dwell))


def compute_escape_probability(obs, N_esc=50):
    escapes = 0
    trials = 0
    T = len(obs)
    for t in range(T - 1):
        basin = obs[t]
        segment = obs[t+1:min(T, t+1+N_esc)]
        trials += 1
        if np.any(segment != basin):
            escapes += 1
    return escapes / trials


# ============================================================
# 7. LOCAL KERNELS & PERSISTENCE (BASIN-LEVEL)
# ============================================================

def basin_transition_kernel(hidden, basins):
    basin_trans_counts = {x: defaultdict(int) for x in basins.keys()}
    basin_from_counts = {x: defaultdict(int) for x in basins.keys()}

    for t in range(len(hidden) - 1):
        u, v = hidden[t], hidden[t+1]
        for x, states_x in basins.items():
            if u in states_x:
                basin_trans_counts[x][(u, v)] += 1
                basin_from_counts[x][u] += 1
                break

    basin_kernels = {x: defaultdict(float) for x in basins.keys()}
    for x in basins.keys():
        for (u, v), c in basin_trans_counts[x].items():
            basin_kernels[x][(u, v)] = c / basin_from_counts[x][u]
    return basin_kernels


def basin_persistence(obs):
    T = len(obs) - 1
    if T <= 0:
        return {x: 0.0 for x in range(4)}

    counts_total = {x: 0 for x in range(4)}
    counts_same = {x: 0 for x in range(4)}

    for t in range(T):
        b_t = obs[t]
        b_tp1 = obs[t+1]
        counts_total[b_t] += 1
        if b_tp1 == b_t:
            counts_same[b_t] += 1

    persistence = {}
    for x in range(4):
        if counts_total[x] == 0:
            persistence[x] = 0.0
        else:
            persistence[x] = counts_same[x] / counts_total[x]
    return persistence


def entropy_from_kernel(kernel_x):
    by_u = defaultdict(list)
    for (u, v), p_uv in kernel_x.items():
        by_u[u].append(p_uv)

    H = 0.0
    total_u = 0
    for u, probs in by_u.items():
        p_arr = np.array(probs, dtype=float)
        p_arr = p_arr[p_arr > 0]
        if len(p_arr) == 0:
            continue
        H_u = -np.sum(p_arr * np.log(p_arr))
        H += H_u
        total_u += 1

    if total_u == 0:
        return 0.0
    return H / total_u


def local_coherence(hidden, obs, basins, alpha=1.0):
    basin_kernels = basin_transition_kernel(hidden, basins)
    persistence = basin_persistence(obs)

    C_x = {}
    for x in basins.keys():
        H_x = entropy_from_kernel(basin_kernels[x])
        C_x[x] = -H_x + alpha * persistence[x]
    return C_x, basin_kernels


# ============================================================
# 8. COMPATIBILITY FUNCTIONALS K_value, K_dyn
# ============================================================

def K_value(C_x):
    pairs = list(itertools.combinations(C_x.keys(), 2))
    if not pairs:
        return 0.0
    s = 0.0
    for x, y in pairs:
        diff = C_x[x] - C_x[y]
        s += diff * diff
    return -s / len(pairs)


def kernel_distance_L2(kernel_x, kernel_y):
    keys = set(kernel_x.keys()) | set(kernel_y.keys())
    s = 0.0
    for k in keys:
        px = kernel_x.get(k, 0.0)
        py = kernel_y.get(k, 0.0)
        diff = px - py
        s += diff * diff
    return s


def K_dyn(basin_kernels, basins):
    pairs = list(itertools.combinations(basins.keys(), 2))
    if not pairs:
        return 0.0
    s = 0.0
    for x, y in pairs:
        d_xy = kernel_distance_L2(basin_kernels[x], basin_kernels[y])
        s += d_xy
    return -s / len(pairs)


# ============================================================
# 9. β-SWEEP WITH LOCAL COHERENCE & COMPATIBILITY
# ============================================================

def run_beta_sweep():
    betas = np.arange(0.5, 2.05, 0.05)
    seeds = range(1, 51)

    print("=== RCFT β-critical sweep with local coherence & compatibility ===")
    print("λ=1.0, δ=0.95, memory_sign=-1, 50 seeds, 2000 steps\n")

    for beta in betas:
        Hc_list = []
        He_list = []
        Ne_list = []
        Dw_list = []
        Esc_list = []

        # local coherence & compatibility
        Cx_all = []          # list of dicts per seed
        Kval_list = []
        Kdyn_list = []

        for seed in seeds:
            cfg = Config(lam=1.0, delta=0.95, beta=beta, seed=seed)
            hidden, obs, edge_counts = simulate(cfg)

            # global metrics
            Hc = compute_conditional_entropy(hidden)
            He = compute_edge_entropy(edge_counts)
            Ne = math.exp(He)
            Dw = compute_dwell_time(obs)
            Esc = compute_escape_probability(obs)

            Hc_list.append(Hc)
            He_list.append(He)
            Ne_list.append(Ne)
            Dw_list.append(Dw)
            Esc_list.append(Esc)

            # local coherence + compatibility
            C_x, basin_kernels = local_coherence(hidden, obs, basins, alpha=1.0)
            K_val = K_value(C_x)
            K_d = K_dyn(basin_kernels, basins)

            Cx_all.append(C_x)
            Kval_list.append(K_val)
            Kdyn_list.append(K_d)

        print(f"β={beta:.2f}")
        print(f"  H_cond: mean={np.mean(Hc_list):.4f}, std={np.std(Hc_list):.4f}")
        print(f"  H_edge: mean={np.mean(He_list):.4f}, std={np.std(He_list):.4f}")
        print(f"  N_eff:  mean={np.mean(Ne_list):.4f}, std={np.std(Ne_list):.4f}")
        print(f"  dwell:  mean={np.mean(Dw_list):.2f}, std={np.std(Dw_list):.2f}")
        print(f"  escape: mean={np.mean(Esc_list):.4f}, std={np.std(Esc_list):.4f}")

        # aggregate local coherence per basin
        Cx_means = {x: np.mean([C_x[x] for C_x in Cx_all]) for x in basins.keys()}
        Cx_stds = {x: np.std([C_x[x] for C_x in Cx_all]) for x in basins.keys()}

        print("  local coherence per basin (mean ± std):")
        for x in basins.keys():
            print(f"    basin {x}: {Cx_means[x]:.4f} ± {Cx_stds[x]:.4f}")

        print(f"  K_value: mean={np.mean(Kval_list):.4f}, std={np.std(Kval_list):.4f}")
        print(f"  K_dyn:   mean={np.mean(Kdyn_list):.4f}, std={np.std(Kdyn_list):.4f}")
        print()


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":
    run_beta_sweep()






