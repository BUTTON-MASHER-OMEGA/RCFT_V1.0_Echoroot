    }


# ============================================================
# 23. PAIR SUMMARY
# ============================================================

def summarize_pair(
    rows,
    a,
    b
):

    pair_rows = []


    for r in rows:

        pair_rows.append(
            pair_similarity(
                r["metrics"][a],
                r["metrics"][b]
            )
        )


    return {

        "mean_centroid_distance":
            safe_mean(
                [
                    p[
                        "centroid_distance"
                    ]
                    for p in pair_rows
                ]
            ),

        "mean_covariance_distance":
            safe_mean(
                [
                    p[
                        "covariance_distance"
                    ]
                    for p in pair_rows
                ]
            ),

        "mean_relative_period_difference":
            safe_mean(
                [
                    p[
                        "relative_period_difference"
                    ]
                    for p in pair_rows
                ]
            ),
    }


