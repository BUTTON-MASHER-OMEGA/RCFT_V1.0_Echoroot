            ),

        "mean_spec_C_concentration":
            safe_mean(
                [
                    m[
                        "spec_C_concentration"
                    ]
                    for m in ms
                ]
            ),

        "mean_recurrence_fraction":
            safe_mean(
                [
                    m[
                        "recurrence_fraction"
                    ]
                    for m in ms
                ]
            ),

        "mean_slope_C":
