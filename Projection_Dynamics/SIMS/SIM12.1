        )


        print(
            f"mean log(V_eff)                    : "
            f"{s['mean_logV']:.6f}"
        )


        print(
            "\nPRINCIPAL GEOMETRY"
        )


        print(
            f"mean lambda_parallel               : "
            f"{s['mean_lambda_parallel']:.8f}"
        )


        print(
