        )


        print(
            f"mean manifold slope d(logV)/dC     : "
            f"{s['mean_manifold_slope']:.6f}"
        )


        print(
            "\nAXIS STABILITY"
        )


        print(
            f"mean early/late axis shift (deg)   : "
            f"{s['mean_axis_shift_deg']:.6f}"
        )


        print(
            f"median early/late axis shift (deg) : "
            f"{s['median_axis_shift_deg']:.6f}"
        )


        print(
            "\nTEMPORAL PERSISTENCE"
        )


        print(
            f"parallel autocorr persistence      : "
            f"{s['mean_parallel_persistence']:.6f}"
        )


        print(
            f"perp autocorr persistence          : "
            f"{s['mean_perp_persistence']:.6f}"
        )


        print(
            "\nTRANSVERSE EXCURSIONS"
        )


        print(
            f"mean excursion fraction            : "
            f"{s['mean_excursion_fraction']:.6f}"
        )


        print(
            f"mean excursion count               : "
            f"{s['mean_excursion_count']:.3f}"
        )


        print(
            f"mean transverse return steps       : "
            f"{s['mean_transverse_return_steps']:.3f}"
        )


        print(
            f"median transverse return steps     : "
            f"{s['median_transverse_return_steps']:.3f}"
        )


    # --------------------------------------------------------
    # Pair structure
    # --------------------------------------------------------

    print(
        "\n"
        + "=" * 60
    )


    print(
        "BASIN-PAIR PRINCIPAL-AXIS SIMILARITY"
    )


    print(
        "=" * 60
    )


    for a, b in [
        (0, 3),
        (1, 2)
    ]:

        p = pair_axis_similarity(
            rows,
            a,
            b
        )


        print(
            f"\nPAIR ({a},{b})"
        )


        print(
            f"mean principal-axis angle (deg)   : "
            f"{p['mean_axis_angle_deg']:.6f}"
        )


        print(
            f"median principal-axis angle (deg) : "
            f"{p['median_axis_angle_deg']:.6f}"
        )


        print(
            f"mean manifold slope difference    : "
            f"{p['mean_slope_difference']:.6f}"
        )


    return rows


