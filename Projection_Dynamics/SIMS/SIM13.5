        "Maximum s=0 diagnostic difference: "
        f"{max(zero_max_differences):.3e}"
    )

    print(
        "Kernel chronology PASS           : "
        f"{chronology['passed']}"
    )

    print(
        "Maximum rho1(K) window difference: "
        f"{chronology['max_difference']:.9f}"
    )

    print(
        "Allowed rho1(K) difference       : "
        f"{cfg.kernel_rho1_tolerance:.6f}"
    )

    # ------------------------------------------------------
    # Tables
    # ------------------------------------------------------

    print_primary_table(
        response
    )

    print_basin_check(
        diag,
        cfg,
    )

    print_secondary_table(
        diag,
        cfg,
    )

    # ------------------------------------------------------
    # Crossover confirmation points
    # ------------------------------------------------------

    post_majority_pass = False

    p_a = np.nan
    p_b = np.nan

    if crossover[
        "exists"
    ]:

        (
            s_a,
            s_b,
        ) = crossover[
            "positive_pair"
        ]

        offset_list = list(
            response[
                "offsets"
            ]
        )

        j_a = offset_list.index(
            s_a
        )

        j_b = offset_list.index(
            s_b
        )

        p_a = fraction_positive(
            response[
                "outer"
            ][
                :,
                j_a,
            ]
        )

        p_b = fraction_positive(
            response[
                "outer"
            ][
                :,
                j_b,
            ]
        )

        post_majority_pass = (
            p_a
            >= cfg.post_majority_threshold
            and p_b
            >= cfg.post_majority_threshold
        )

    bootstrap_pass = (
        bootstrap[
            "finite_fraction"
        ]
        >= cfg.bootstrap_finite_threshold
    )

    crossover_replicated = (
        zero_gate_passed
        and chronology[
            "passed"
        ]
        and crossover[
            "exists"
        ]
        and post_majority_pass
        and bootstrap_pass
    )

    # ------------------------------------------------------
    # Crossover result
    # ------------------------------------------------------

    print()

    print(
        "=" * 92
    )

    print(
        "PREREGISTERED CROSSOVER RESULT"
    )

    print(
        "=" * 92
    )

    print(
        "Finite median-curve crossover : "
        f"{crossover['exists']}"
    )

    print(
        "Estimator status              : "
        f"{crossover['reason']}"
    )

    if crossover[
        "exists"
    ]:

        print(
            "Interpolation bracket        : "
            f"{crossover['s_minus']:.0f}"
            " -> "
            f"{crossover['s_plus']:.0f}"
        )

        print(
            "Positive confirmation pair   : "
            f"{crossover['positive_pair']}"
        )

        print(
            "Estimated s_c                : "
            f"{crossover['s_c']:.6f}"
        )

        print(
            "P(out>0), first positive pt  : "
            f"{p_a:.3f}"
        )

        print(
            "P(out>0), second positive pt : "
            f"{p_b:.3f}"
        )

        print(
            "Post-majority gate           : "
            f"{post_majority_pass}"
        )

    print()

    print(
        "Bootstrap finite crossover rate: "
        f"{bootstrap['finite_fraction']:.3f}"
    )

    print(
        "Required finite rate            : "
        f"{cfg.bootstrap_finite_threshold:.3f}"
    )

    print(
        "Bootstrap finite-rate PASS      : "
        f"{bootstrap_pass}"
    )

    if np.isfinite(
        bootstrap[
            "median"
        ]
    ):

        print(
            "Bootstrap median s_c            : "
            f"{bootstrap['median']:.6f}"
        )

        print(
            "Bootstrap 95% interval          : "
            f"["
            f"{bootstrap['ci95'][0]:.6f}, "
            f"{bootstrap['ci95'][1]:.6f}"
            f"]"
        )

    print()

    print(
        "CROSSOVER REPLICATED             : "
        f"{crossover_replicated}"
    )

    # ------------------------------------------------------
    # Context-only memory timescale
    # ------------------------------------------------------

    memory_half_life = (
        math.log(0.5)
        / math.log(
            cfg.delta
        )
    )

    memory_tau = (
        -1.0
        / math.log(
            cfg.delta
        )
    )

    print()

    print(
        "=" * 92
    )

    print(
        "POST-ESTIMATION CONTEXT ONLY"
    )

    print(
        "=" * 92
    )

    print(
        "Bare memory e-folding time tau : "
        f"{memory_tau:.6f}"
    )

    print(
        "Bare memory half-life          : "
        f"{memory_half_life:.6f}"
    )

    if crossover[
        "exists"
    ]:

        print(
            "s_c / tau                     : "
            f"{crossover['s_c'] / memory_tau:.6f}"
        )

        print(
            "s_c / t_half                  : "
            f"{crossover['s_c'] / memory_half_life:.6f}"
        )

    print()

    print(
        "SIM13.5 does NOT interpret either ratio "
        "as evidence of timescale scaling."
    )

    print(
        "That hypothesis belongs to SIM13.6."
    )

    # ------------------------------------------------------
    # Truth packet
    # ------------------------------------------------------

    print()

    print(
        "=" * 92
    )

    print(
        "SIM13.5 TRUTH-PACKET STATUS"
    )

    print(
        "=" * 92
    )

    if crossover_replicated:

        print(
            "SUPPORTED:"
        )

        print(
            "The outer pair exhibits a reproducible "
            "biphasic temporal-displacement response "
            "with a finite characteristic crossover s_c."
        )

    elif crossover[
        "exists"
    ]:

        print(
            "PARTIAL:"
        )

        print(
            "A median-curve crossover exists, but one "
            "or more preregistered replication or "
            "validity gates did not pass."
        )

    else:

        print(
            "NOT REPLICATED:"
        )

        print(
            "The apparent SIM13.4 outer crossover "
            "does not survive the preregistered "
            "SIM13.5 crossover definition."
        )

    print()

    print(
        "No frequency or resonance interpretation permitted."
    )

    return {

        "runs":
            runs,

        "response":
            response,

        "diagnostics":
            diag,

        "chronology":
            chronology,

        "crossover":
            crossover,

        "bootstrap":
            bootstrap,

        "zero_gate_passed":
            zero_gate_passed,

        "crossover_replicated":
            crossover_replicated,

        "memory_tau":
            memory_tau,

        "memory_half_life":
            memory_half_life,
    }


