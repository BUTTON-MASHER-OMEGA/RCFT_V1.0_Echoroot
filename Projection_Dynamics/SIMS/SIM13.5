# ======================================================================
# SIM13.5 — TARGETED OUTER-PAIR CROSSOVER REPLICATION
# ======================================================================
#
# SCIENTIFIC QUESTION
# -------------------
#
# Does the outer basin class C_A={0,3} exhibit a reproducible biphasic
# response to controlled temporal displacement s, and if so, what is the
# characteristic zero-crossing scale s_c?
#
# SIM13.5 is a targeted replication/refinement of SIM13.4.
#
# NOTHING NEW IS ADDED TO THE DYNAMICS.
#
# Frozen:
#   beta   = 1.38
#   delta  = 0.95
#   lambda = 1.0
#   T_tol  = 1.0
#
#   C8 graph
#   projection labeling
#   memory law
#   candidate LCO
#   Z=(C, log V_eff)
#   branch-point replay architecture
#   common random numbers
#
# Experimental refinements only:
#   1. dense near-zero displacement grid
#   2. N=100 paired seeds
#   3. preregistered crossover estimator
#   4. bootstrap uncertainty
#
# PRIMARY RESPONSE
# ----------------
#
#   Delta kappa_x(s) = kappa_x(0) - kappa_x(s)
#
# Outer:
#
#   Delta kappa_A(s)
#       = 1/2 [Delta kappa_0(s) + Delta kappa_3(s)]
#
# Inner control:
#
#   Delta kappa_B(s)
#       = 1/2 [Delta kappa_1(s) + Delta kappa_2(s)]
#
# Class contrast:
#
#   D_kappa(s) = Delta kappa_A(s) - Delta kappa_B(s)
#
# SIGN:
#
#   Delta kappa < 0
#       displacement strengthened one-step restoration
#
#   Delta kappa > 0
#       displacement weakened one-step restoration
#
# CROSSOVER ESTIMATOR
# -------------------
#
# Let
#
#   m_A(s) = median_seed[Delta kappa_A(s)]
#
# Require:
#
#   1. a negative-response lobe at s>0
#   2. afterward, two consecutive sampled points with m_A(s)>0
#
# Then linearly interpolate between:
#
#   s_- = final nonpositive point before confirmed positive regime
#   s_+ = first point of confirmed positive regime
#
# No spline.
# No polynomial.
# No frequency fit.
# No resonance interpretation.
#
# CROSSOVER REPLICATION GATE
# --------------------------
#
# A. exact s=0 replay passes for every seed
# B. kernel chronology gate passes
# C. finite preregistered s_c exists
# D. first two positive-regime points each satisfy:
#
#       P(Delta kappa_A > 0) >= 0.60
#
# E. >=80% of bootstrap resamples produce finite crossover
#
# ======================================================================

import math
from collections import deque
from dataclasses import dataclass

import numpy as np


# ======================================================================
# 1. GRAPH AND PROJECTION
# ======================================================================

NBR = np.array(
    [
        [1, 2],  # 0
        [0, 3],  # 1
        [0, 4],  # 2
        [1, 5],  # 3
        [2, 6],  # 4
        [3, 7],  # 5
        [4, 7],  # 6
        [5, 6],  # 7
    ],
    dtype=np.int8,
)

PROJ = np.array(
    [0, 0, 1, 1, 2, 2, 3, 3],
    dtype=np.int8,
)

BASINS = np.array(
    [
        [0, 1],
        [2, 3],
        [4, 5],
        [6, 7],
    ],
    dtype=np.int8,
)

DP = (
    PROJ[NBR]
    != PROJ[:, None]
).astype(np.float64)

SAME_PROJ = (
    PROJ[NBR]
    == PROJ[:, None]
)


# ======================================================================
# 2. CONFIGURATION
# ======================================================================

@dataclass
class Config:

    # Frozen dynamics
    lam: float = 1.0
    delta: float = 0.95
    beta: float = 1.38
    alpha: float = 1.0
    Ttol: float = 1.0

    # Frozen timeline
    burnin: int = 3000
    reference: int = 4000
    observation: int = 6000

    # Frozen diagnostics
    diagnostic_every: int = 5
    stats_window: int = 100

    # Restoring-field fit
    fit_q_abs_max: float = 1.5
    min_bin_count: int = 40

    q_edges: tuple = (
        -3.0,
        -2.0,
        -1.5,
        -1.0,
        -0.5,
        0.0,
        0.5,
        1.0,
        1.5,
        2.0,
        3.0,
    )

    # SIM13.5 targeted displacement grid
    offsets: tuple = (
        0,
        2,
        3,
        4,
        5,
        6,
        8,
        10,
        12,
        13,
        14,
        15,
        16,
        18,
        20,
        25,
        30,
    )

    # Validity gates
    replay_zero_tol: float = 1e-12
    kernel_rho1_tolerance: float = 0.03

    # Crossover gates
    post_majority_threshold: float = 0.60
    bootstrap_finite_threshold: float = 0.80


CFG = Config()


# ======================================================================
# 3. BASIC HELPERS
# ======================================================================

def stable_logistic_minus(z):

    z = np.asarray(
        z,
        dtype=float,
    )

    out = np.empty_like(z)

    pos = z >= 0

    ez = np.exp(
        -z[pos]
    )

    out[pos] = (
        ez
        / (1.0 + ez)
    )

    neg = ~pos

    ez = np.exp(
        z[neg]
    )

    out[neg] = (
        1.0
        / (1.0 + ez)
    )

    return out


def finite_array(values):

    arr = np.asarray(
        values,
        dtype=float,
    )

    return arr[
        np.isfinite(arr)
    ]


def mean_value(values):

    arr = finite_array(values)

    if len(arr) == 0:
        return np.nan

    return float(
        np.mean(arr)
    )


def median_value(values):

    arr = finite_array(values)

    if len(arr) == 0:
        return np.nan

    return float(
        np.median(arr)
    )


def iqr_value(values):

    arr = finite_array(values)

    if len(arr) == 0:
        return np.nan

    return float(
        np.quantile(arr, 0.75)
        - np.quantile(arr, 0.25)
    )


def fraction_positive(values):

    arr = finite_array(values)

    if len(arr) == 0:
        return np.nan

    return float(
        np.mean(
            arr > 0
        )
    )


def safe_corr(x, y):

    x = np.asarray(
        x,
        dtype=float,
    )

    y = np.asarray(
        y,
        dtype=float,
    )

    mask = (
        np.isfinite(x)
        & np.isfinite(y)
    )

    x = x[mask]
    y = y[mask]

    if len(x) < 3:
        return np.nan

    sx = np.std(x)
    sy = np.std(y)

    if (
        sx < 1e-14
        or sy < 1e-14
    ):
        return np.nan

    return float(
        np.corrcoef(
            x,
            y,
        )[0, 1]
    )


def lag1_corr(x):

    x = np.asarray(
        x,
        dtype=float,
    )

    if len(x) < 3:
        return np.nan

    return safe_corr(
        x[:-1],
        x[1:],
    )


def kernel_lag1_corr(kernel_log):

    K = np.asarray(
        kernel_log,
        dtype=float,
    )

    if len(K) < 3:
        return np.nan

    return safe_corr(
        K[:-1].reshape(-1),
        K[1:].reshape(-1),
    )


# ======================================================================
# 4. ISP KERNEL
# ======================================================================

def all_native_probs(
    memory,
    cfg=CFG,
):

    m = np.tanh(
        memory
    )

    projection_difference = (
        DP[:, 0]
        - DP[:, 1]
    )

    memory_difference = (
        m[:, 0]
        - m[:, 1]
    )

    delta_cost = (
        cfg.beta
        * projection_difference
        - cfg.lam
        * memory_difference
    )

    z = (
        delta_cost
        / cfg.Ttol
    )

    p0 = stable_logistic_minus(
        z
    )

    probs = np.empty(
        (8, 2),
        dtype=float,
    )

    probs[:, 0] = p0
    probs[:, 1] = 1.0 - p0

    return probs


# ======================================================================
# 5. MEMORY
# ======================================================================

def update_memory(
    memory,
    u,
    slot,
    cfg=CFG,
):

    memory *= cfg.delta

    memory[
        u,
        slot,
    ] += 1.0


# ======================================================================
# 6. CANDIDATE LCO
# ======================================================================

def compute_L(
    probs_all,
    cfg=CFG,
):

    probs_all = np.asarray(
        probs_all,
        dtype=float,
    )

    H_nodes = -np.sum(
        probs_all
        * np.log(
            probs_all
            + 1e-15
        ),
        axis=1,
    )

    P_nodes = np.sum(
        probs_all
        * SAME_PROJ,
        axis=1,
    )

    H_basin = np.mean(
        H_nodes[BASINS],
        axis=1,
    )

    P_basin = np.mean(
        P_nodes[BASINS],
        axis=1,
    )

    return (
        -H_basin
        + cfg.alpha
        * P_basin
    )


# ======================================================================
# 7. COHERENCE / VALENCE OBSERVABLE
# ======================================================================

def compute_Z(
    hidden,
    obs,
    probs_all,
    cfg=CFG,
):

    hidden_arr = np.asarray(
        hidden,
        dtype=np.int16,
    )

    obs_arr = np.asarray(
        obs,
        dtype=np.int16,
    )

    src = hidden_arr[:-1]
    dst = hidden_arr[1:]

    basin_now = obs_arr[:-1]
    basin_next = obs_arr[1:]

    edge_counts = np.bincount(
        src * 8 + dst,
        minlength=64,
    ).reshape(
        8,
        8,
    )

    H_local = np.zeros(
        4,
        dtype=float,
    )

    P_local = np.zeros(
        4,
        dtype=float,
    )

    for x in range(4):

        mask = (
            basin_now == x
        )

        if np.any(mask):

            P_local[x] = float(
                np.mean(
                    basin_next[mask]
                    == x
                )
            )

        entropies = []

        for u in BASINS[x]:

            c0 = edge_counts[
                u,
                NBR[u, 0],
            ]

            c1 = edge_counts[
                u,
                NBR[u, 1],
            ]

            total = (
                c0 + c1
            )

            if total <= 0:
                continue

            p0 = (
                c0 / total
            )

            p1 = (
                c1 / total
            )

            H = 0.0

            if p0 > 0:

                H -= (
                    p0
                    * math.log(p0)
                )

            if p1 > 0:

                H -= (
                    p1
                    * math.log(p1)
                )

            entropies.append(
                H
            )

        if entropies:

            H_local[x] = float(
                np.mean(
                    entropies
                )
            )

    C_local = (
        -H_local
        + cfg.alpha
        * P_local
    )

    H_nodes = -np.sum(
        probs_all
        * np.log(
            probs_all
            + 1e-15
        ),
        axis=1,
    )

    V_nodes = np.exp(
        H_nodes
    )

    V_basin = np.mean(
        V_nodes[BASINS],
        axis=1,
    )

    logV = np.log(
        np.maximum(
            V_basin,
            1e-15,
        )
    )

    return np.column_stack(
        (
            C_local,
            logV,
        )
    )


# ======================================================================
# 8. BURN-IN
# ======================================================================

def run_burnin(
    rng,
    state,
    memory,
    hidden,
    obs,
    steps,
    cfg=CFG,
):

    u = int(state)

    for _ in range(
        steps
    ):

        probs = all_native_probs(
            memory,
            cfg,
        )

        r = rng.random()

        slot = (
            0
            if r < probs[u, 0]
            else 1
        )

        v = int(
            NBR[u, slot]
        )

        update_memory(
            memory,
            u,
            slot,
            cfg,
        )

        hidden.append(
            v
        )

        obs.append(
            int(
                PROJ[v]
            )
        )

        u = v

    return (
        u,
        memory,
        hidden,
        obs,
    )


# ======================================================================
# 9. LOG ALLOCATION
# ======================================================================

def allocate_logs(
    total_branch_steps,
    cfg=CFG,
):

    n_diag = (
        (total_branch_steps - 1)
        // cfg.diagnostic_every
        + 1
    )

    return {

        "Z":
            np.empty(
                (n_diag, 4, 2),
                dtype=float,
            ),

        "L":
            np.empty(
                (n_diag, 4),
                dtype=float,
            ),

        "K":
            np.empty(
                (n_diag, 8, 2),
                dtype=float,
            ),

        "TV":
            np.empty(
                (n_diag, 4),
                dtype=float,
            ),

        "KL":
            np.empty(
                (n_diag, 4),
                dtype=float,
            ),
    }


# ======================================================================
# 10. KERNEL MISMATCH
# ======================================================================

def kernel_mismatch_by_basin(
    latent,
    used,
):

    latent = np.asarray(
        latent,
        dtype=float,
    )

    used = np.asarray(
        used,
        dtype=float,
    )

    node_TV = (
        0.5
        * np.sum(
            np.abs(
                latent
                - used
            ),
            axis=1,
        )
    )

    node_KL = np.sum(
        latent
        * np.log(
            (
                latent
                + 1e-15
            )
            /
            (
                used
                + 1e-15
            )
        ),
        axis=1,
    )

    basin_TV = np.mean(
        node_TV[BASINS],
        axis=1,
    )

    basin_KL = np.mean(
        node_KL[BASINS],
        axis=1,
    )

    return (
        basin_TV,
        basin_KL,
    )


# ======================================================================
# 11. GENERATE CONTEMPORANEOUS NATIVE DRIVER
# ======================================================================

def generate_native_driver(
    state0,
    memory0,
    hidden0,
    obs0,
    uniforms,
    branch_steps,
    cfg=CFG,
):

    driver_steps = len(
        uniforms
    )

    u = int(
        state0
    )

    memory = memory0.copy()

    hidden = deque(
        hidden0,
        maxlen=hidden0.maxlen,
    )

    obs = deque(
        obs0,
        maxlen=obs0.maxlen,
    )

    K_sequence = np.empty(
        (
            driver_steps,
            8,
            2,
        ),
        dtype=float,
    )

    native_logs = allocate_logs(
        branch_steps,
        cfg,
    )

    native_path = np.empty(
        branch_steps + 1,
        dtype=np.int8,
    )

    native_path[0] = u

    d = 0

    for t in range(
        driver_steps
    ):

        probs = all_native_probs(
            memory,
            cfg,
        )

        K_sequence[t] = probs

        r = uniforms[t]

        slot = (
            0
            if r < probs[u, 0]
            else 1
        )

        v = int(
            NBR[u, slot]
        )

        update_memory(
            memory,
            u,
            slot,
            cfg,
        )

        hidden.append(
            v
        )

        obs.append(
            int(
                PROJ[v]
            )
        )

        u = v

        if t < branch_steps:

            native_path[
                t + 1
            ] = u

            if (
                t
                % cfg.diagnostic_every
                == 0
            ):

                native_logs[
                    "Z"
                ][d] = compute_Z(
                    hidden,
                    obs,
                    probs,
                    cfg,
                )

                native_logs[
                    "L"
                ][d] = compute_L(
                    probs,
                    cfg,
                )

                native_logs[
                    "K"
                ][d] = probs

                native_logs[
                    "TV"
                ][d] = 0.0

                native_logs[
                    "KL"
                ][d] = 0.0

                d += 1

    for key in native_logs:

        native_logs[key] = (
            native_logs[key][:d]
        )

    return (
        K_sequence,
        native_logs,
        native_path,
    )


# ======================================================================
# 12. TEMPORAL REPLAY
# ======================================================================

def run_replay_offset(
    state0,
    memory0,
    hidden0,
    obs0,
    uniforms,
    K_native,
    offset,
    branch_steps,
    cfg=CFG,
):

    u = int(
        state0
    )

    memory = memory0.copy()

    hidden = deque(
        hidden0,
        maxlen=hidden0.maxlen,
    )

    obs = deque(
        obs0,
        maxlen=obs0.maxlen,
    )

    logs = allocate_logs(
        branch_steps,
        cfg,
    )

    path = np.empty(
        branch_steps + 1,
        dtype=np.int8,
    )

    path[0] = u

    d = 0

    for t in range(
        branch_steps
    ):

        latent = all_native_probs(
            memory,
            cfg,
        )

        used = K_native[
            t + offset
        ]

        r = uniforms[t]

        slot = (
            0
            if r < used[u, 0]
            else 1
        )

        v = int(
            NBR[u, slot]
        )

        update_memory(
            memory,
            u,
            slot,
            cfg,
        )

        hidden.append(
            v
        )

        obs.append(
            int(
                PROJ[v]
            )
        )

        u = v

        path[
            t + 1
        ] = u

        if (
            t
            % cfg.diagnostic_every
            == 0
        ):

            logs[
                "Z"
            ][d] = compute_Z(
                hidden,
                obs,
                used,
                cfg,
            )

            logs[
                "L"
            ][d] = compute_L(
                used,
                cfg,
            )

            logs[
                "K"
            ][d] = used

            (
                basin_TV,
                basin_KL,
            ) = kernel_mismatch_by_basin(
                latent,
                used,
            )

            logs[
                "TV"
            ][d] = basin_TV

            logs[
                "KL"
            ][d] = basin_KL

            d += 1

    for key in logs:

        logs[key] = (
            logs[key][:d]
        )

    return (
        logs,
        path,
    )


# ======================================================================
# 13. MANIFOLD AXES
# ======================================================================

def axes_from_reference(
    Z,
):

    Z = np.asarray(
        Z,
        dtype=float,
    )

    mu = np.mean(
        Z,
        axis=0,
    )

    centered = (
        Z - mu
    )

    cov = np.cov(
        centered.T
    )

    (
        eigvals,
        eigvecs,
    ) = np.linalg.eigh(
        cov
    )

    order = np.argsort(
        eigvals
    )[::-1]

    eigvals = eigvals[
        order
    ]

    eigvecs = eigvecs[
        :,
        order,
    ]

    e_parallel = eigvecs[
        :,
        0,
    ].copy()

    e_perp = eigvecs[
        :,
        1,
    ].copy()

    if e_parallel[0] < 0:

        e_parallel *= -1.0

    determinant = (
        e_parallel[0]
        * e_perp[1]
        - e_parallel[1]
        * e_perp[0]
    )

    if determinant < 0:

        e_perp *= -1.0

    lambda_parallel = max(
        float(
            eigvals[0]
        ),
        1e-15,
    )

    lambda_perp = max(
        float(
            eigvals[1]
        ),
        1e-15,
    )

    sigma_perp = math.sqrt(
        lambda_perp
    )

    anisotropy = (
        lambda_parallel
        / lambda_perp
    )

    return (
        mu,
        e_perp,
        sigma_perp,
        anisotropy,
    )


# ======================================================================
# 14. RESTORING FRACTION
# ======================================================================

def restoring_fraction(
    q_now,
    dq,
    cfg=CFG,
):

    flags = []

    for i in range(
        len(cfg.q_edges) - 1
    ):

        lo = cfg.q_edges[i]
        hi = cfg.q_edges[i + 1]

        mask = (
            (q_now >= lo)
            & (q_now < hi)
        )

        if (
            int(
                np.sum(mask)
            )
            < cfg.min_bin_count
        ):

            continue

        mean_q = float(
            np.mean(
                q_now[mask]
            )
        )

        mean_dq = float(
            np.mean(
                dq[mask]
            )
        )

        flags.append(
            mean_q
            * mean_dq
            < 0
        )

    if not flags:
        return np.nan

    return float(
        np.mean(flags)
    )


# ======================================================================
# 15. SPLIT REFERENCE / OBSERVATION
# ======================================================================

def split_logs(
    logs,
    cfg=CFG,
):

    n_reference_diag = (
        (cfg.reference - 1)
        // cfg.diagnostic_every
        + 1
    )

    reference = {}
    observation = {}

    for (
        key,
        arr,
    ) in logs.items():

        reference[key] = arr[
            :n_reference_diag
        ]

        observation[key] = arr[
            n_reference_diag:
        ]

    return (
        reference,
        observation,
    )


# ======================================================================
# 16. ANALYZE BRANCH
# ======================================================================

def analyze_logs(
    logs,
    cfg=CFG,
):

    (
        reference,
        observation,
    ) = split_logs(
        logs,
        cfg,
    )

    out = {}

    for x in range(4):

        (
            mu,
            e_perp,
            sigma_perp,
            anisotropy,
        ) = axes_from_reference(
            reference[
                "Z"
            ][
                :,
                x,
                :,
            ]
        )

        q = (
            (
                observation[
                    "Z"
                ][
                    :,
                    x,
                    :,
                ]
                - mu
            )
            @ e_perp
        ) / max(
            sigma_perp,
            1e-15,
        )

        q_now = q[:-1]
        q_next = q[1:]

        dq = (
            q_next
            - q_now
        )

        fit_mask = (
            np.isfinite(q_now)
            & np.isfinite(dq)
            & (
                np.abs(q_now)
                <= cfg.fit_q_abs_max
            )
        )

        q_fit = q_now[
            fit_mask
        ]

        dq_fit = dq[
            fit_mask
        ]

        q_next_fit = q_next[
            fit_mask
        ]

        if len(q_fit) < 10:

            kappa = np.nan
            phi_fit = np.nan
            identity_error = np.nan

        else:

            X = np.column_stack(
                (
                    q_fit,
                    np.ones(
                        len(q_fit)
                    ),
                )
            )

            (
                coef,
                _,
                _,
                _,
            ) = np.linalg.lstsq(
                X,
                dq_fit,
                rcond=None,
            )

            kappa = -float(
                coef[0]
            )

            (
                coef_ar,
                _,
                _,
                _,
            ) = np.linalg.lstsq(
                X,
                q_next_fit,
                rcond=None,
            )

            phi_fit = float(
                coef_ar[0]
            )

            identity_error = abs(
                kappa
                - (
                    1.0
                    - phi_fit
                )
            )

        out[x] = {

            "kappa":
                kappa,

            "phi_fit":
                phi_fit,

            "kappa_identity_error":
                identity_error,

            "rho1_q":
                lag1_corr(q),

            "restore_fraction":
                restoring_fraction(
                    q_now,
                    dq,
                    cfg,
                ),

            "sigma_perp":
                sigma_perp,

            "anisotropy":
                anisotropy,

            "operator_mean":
                float(
                    np.mean(
                        observation[
                            "L"
                        ][
                            :,
                            x,
                        ]
                    )
                ),

            "operator_std":
                float(
                    np.std(
                        observation[
                            "L"
                        ][
                            :,
                            x,
                        ],
                        ddof=1,
                    )
                ),

            "operator_rho1":
                lag1_corr(
                    observation[
                        "L"
                    ][
                        :,
                        x,
                    ]
                ),

            "TV":
                float(
                    np.mean(
                        observation[
                            "TV"
                        ][
                            :,
                            x,
                        ]
                    )
                ),

            "KL":
                float(
                    np.mean(
                        observation[
                            "KL"
                        ][
                            :,
                            x,
                        ]
                    )
                ),
        }

    out[
        "kernel_rho1"
    ] = kernel_lag1_corr(
        observation[
            "K"
        ]
    )

    return out


# ======================================================================
# 17. s=0 VALIDATION
# ======================================================================

def validate_zero_replay(
    native_logs,
    native_path,
    replay_logs,
    replay_path,
    cfg=CFG,
):

    path_equal = np.array_equal(
        native_path,
        replay_path,
    )

    differences = {}

    for key in (
        "Z",
        "L",
        "K",
        "TV",
        "KL",
    ):

        differences[key] = float(
            np.max(
                np.abs(
                    native_logs[key]
                    - replay_logs[key]
                )
            )
        )

    max_difference = max(
        differences.values()
    )

    passed = (
        path_equal
        and max_difference
        <= cfg.replay_zero_tol
    )

    return {

        "passed":
            passed,

        "path_equal":
            path_equal,

        "max_difference":
            max_difference,

        "differences":
            differences,
    }


# ======================================================================
# 18. ONE PAIRED SEED
# ======================================================================

def simulate_seed(
    seed,
    cfg=CFG,
):

    rng = np.random.default_rng(
        seed
    )

    memory = np.zeros(
        (8, 2),
        dtype=float,
    )

    hidden = deque(
        [0],
        maxlen=(
            cfg.stats_window
            + 1
        ),
    )

    obs = deque(
        [0],
        maxlen=(
            cfg.stats_window
            + 1
        ),
    )

    (
        state0,
        memory0,
        hidden0,
        obs0,
    ) = run_burnin(
        rng,
        0,
        memory,
        hidden,
        obs,
        cfg.burnin,
        cfg,
    )

    memory_start = (
        memory0.copy()
    )

    hidden_start = deque(
        hidden0,
        maxlen=hidden0.maxlen,
    )

    obs_start = deque(
        obs0,
        maxlen=obs0.maxlen,
    )

    branch_steps = (
        cfg.reference
        + cfg.observation
    )

    max_offset = max(
        cfg.offsets
    )

    driver_steps = (
        branch_steps
        + max_offset
    )

    uniforms = rng.random(
        driver_steps
    )

    (
        K_native,
        native_logs,
        native_path,
    ) = generate_native_driver(
        state0,
        memory_start,
        hidden_start,
        obs_start,
        uniforms,
        branch_steps,
        cfg,
    )

    (
        replay0_logs,
        replay0_path,
    ) = run_replay_offset(
        state0,
        memory_start,
        hidden_start,
        obs_start,
        uniforms,
        K_native,
        0,
        branch_steps,
        cfg,
    )

    zero_validation = (
        validate_zero_replay(
            native_logs,
            native_path,
            replay0_logs,
            replay0_path,
            cfg,
        )
    )

    if not zero_validation[
        "passed"
    ]:

        raise RuntimeError(
            "\nSIM13.5 HARD CONTROL FAILURE\n"
            f"Seed: {seed}\n"
            "Native != replay(s=0)\n"
            f"Path equal: "
            f"{zero_validation['path_equal']}\n"
            f"Max difference: "
            f"{zero_validation['max_difference']:.3e}"
        )

    offset_results = {}

    for s in cfg.offsets:

        if s == 0:

            logs = (
                replay0_logs
            )

        else:

            (
                logs,
                _,
            ) = run_replay_offset(
                state0,
                memory_start,
                hidden_start,
                obs_start,
                uniforms,
                K_native,
                s,
                branch_steps,
                cfg,
            )

        offset_results[s] = (
            analyze_logs(
                logs,
                cfg,
            )
        )

    return {

        "seed":
            seed,

        "offsets":
            offset_results,

        "zero_validation":
            zero_validation,
    }


# ======================================================================
# 19. RESPONSE MATRICES
# ======================================================================

def response_matrices(
    runs,
    cfg=CFG,
):

    offsets = np.asarray(
        cfg.offsets,
        dtype=int,
    )

    n_seeds = len(
        runs
    )

    n_offsets = len(
        offsets
    )

    outer = np.full(
        (
            n_seeds,
            n_offsets,
        ),
        np.nan,
    )

    inner = np.full(
        (
            n_seeds,
            n_offsets,
        ),
        np.nan,
    )

    contrast = np.full(
        (
            n_seeds,
            n_offsets,
        ),
        np.nan,
    )

    basin = {

        x:
            np.full(
                (
                    n_seeds,
                    n_offsets,
                ),
                np.nan,
            )

        for x in range(4)
    }

    for i, run in enumerate(
        runs
    ):

        baseline = run[
            "offsets"
        ][0]

        for j, s in enumerate(
            offsets
        ):

            current = run[
                "offsets"
            ][int(s)]

            dk = {}

            for x in range(4):

                dk[x] = (
                    baseline[x][
                        "kappa"
                    ]
                    - current[x][
                        "kappa"
                    ]
                )

                basin[x][
                    i,
                    j,
                ] = dk[x]

            outer[
                i,
                j,
            ] = 0.5 * (
                dk[0]
                + dk[3]
            )

            inner[
                i,
                j,
            ] = 0.5 * (
                dk[1]
                + dk[2]
            )

            contrast[
                i,
                j,
            ] = (
                outer[
                    i,
                    j,
                ]
                - inner[
                    i,
                    j,
                ]
            )

    return {

        "offsets":
            offsets,

        "outer":
            outer,

        "inner":
            inner,

        "contrast":
            contrast,

        "basin":
            basin,
    }


# ======================================================================
# 20. PREREGISTERED CROSSOVER ESTIMATOR
# ======================================================================

def estimate_crossover(
    offsets,
    median_outer,
):

    offsets = np.asarray(
        offsets,
        dtype=float,
    )

    y = np.asarray(
        median_outer,
        dtype=float,
    )

    valid = (
        np.isfinite(offsets)
        & np.isfinite(y)
    )

    offsets = offsets[
        valid
    ]

    y = y[
        valid
    ]

    # Exclude baseline s=0 from sign-lobe logic.
    mask = (
        offsets > 0
    )

    offsets = offsets[
        mask
    ]

    y = y[
        mask
    ]

    if len(offsets) < 3:

        return {

            "exists":
                False,

            "s_c":
                np.nan,

            "s_minus":
                np.nan,

            "s_plus":
                np.nan,

            "positive_pair":
                None,

            "reason":
                "insufficient finite offsets",
        }

    negative_idx = np.where(
        y < 0
    )[0]

    if len(
        negative_idx
    ) == 0:

        return {

            "exists":
                False,

            "s_c":
                np.nan,

            "s_minus":
                np.nan,

            "s_plus":
                np.nan,

            "positive_pair":
                None,

            "reason":
                "no negative lobe",
        }

    first_negative = int(
        negative_idx[0]
    )

    candidate = None

    for j in range(
        first_negative + 1,
        len(y) - 1,
    ):

        if (
            y[j] > 0
            and y[j + 1] > 0
        ):

            candidate = j

            break

    if candidate is None:

        return {

            "exists":
                False,

            "s_c":
                np.nan,

            "s_minus":
                np.nan,

            "s_plus":
                np.nan,

            "positive_pair":
                None,

            "reason":
                "no confirmed two-point positive regime",
        }

    prior_nonpositive = np.where(
        (
            np.arange(
                len(y)
            )
            < candidate
        )
        & (
            y <= 0
        )
    )[0]

    if len(
        prior_nonpositive
    ) == 0:

        return {

            "exists":
                False,

            "s_c":
                np.nan,

            "s_minus":
                np.nan,

            "s_plus":
                np.nan,

            "positive_pair":
                None,

            "reason":
                "no valid nonpositive interpolation bracket",
        }

    i_minus = int(
        prior_nonpositive[-1]
    )

    i_plus = int(
        candidate
    )

    s_minus = float(
        offsets[i_minus]
    )

    s_plus = float(
        offsets[i_plus]
    )

    y_minus = float(
        y[i_minus]
    )

    y_plus = float(
        y[i_plus]
    )

    denominator = (
        y_plus
        - y_minus
    )

    if abs(
        denominator
    ) < 1e-15:

        s_c = (
            s_plus
        )

    else:

        s_c = (
            s_minus
            + (
                -y_minus
                / denominator
            )
            * (
                s_plus
                - s_minus
            )
        )

    return {

        "exists":
            True,

        "s_c":
            float(s_c),

        "s_minus":
            s_minus,

        "s_plus":
            s_plus,

        "positive_pair":
            (
                int(
                    offsets[i_plus]
                ),
                int(
                    offsets[
                        i_plus + 1
                    ]
                ),
            ),

        "reason":
            "finite preregistered crossover",
    }


# ======================================================================
# 21. BOOTSTRAP CROSSOVER
# ======================================================================

def bootstrap_crossover(
    response,
    n_boot=5000,
    seed=1355,
):

    offsets = response[
        "offsets"
    ]

    outer = response[
        "outer"
    ]

    n_seeds = (
        outer.shape[0]
    )

    rng = np.random.default_rng(
        seed
    )

    estimates = np.full(
        n_boot,
        np.nan,
    )

    for b in range(
        n_boot
    ):

        idx = rng.integers(
            0,
            n_seeds,
            size=n_seeds,
        )

        median_curve = np.nanmedian(
            outer[idx],
            axis=0,
        )

        estimate = estimate_crossover(
            offsets,
            median_curve,
        )

        if estimate[
            "exists"
        ]:

            estimates[b] = estimate[
                "s_c"
            ]

    finite = estimates[
        np.isfinite(
            estimates
        )
    ]

    finite_fraction = (
        len(finite)
        / n_boot
    )

    if len(finite) > 0:

        (
            ci_low,
            boot_med,
            ci_high,
        ) = np.quantile(
            finite,
            [
                0.025,
                0.50,
                0.975,
            ],
        )

    else:

        ci_low = np.nan
        boot_med = np.nan
        ci_high = np.nan

    return {

        "n_boot":
            int(n_boot),

        "finite_fraction":
            float(
                finite_fraction
            ),

        "median":
            float(
                boot_med
            ),

        "ci95":
            (
                float(
                    ci_low
                ),
                float(
                    ci_high
                ),
            ),

        "finite_estimates":
            finite,
    }


# ======================================================================
# 22. KERNEL CHRONOLOGY
# ======================================================================

def chronology_summary(
    runs,
    cfg=CFG,
):

    out = {}

    for s in cfg.offsets:

        values = [

            run[
                "offsets"
            ][s][
                "kernel_rho1"
            ]

            for run in runs
        ]

        out[s] = {

            "mean":
                mean_value(
                    values
                ),

            "median":
                median_value(
                    values
                ),
        }

    rho0 = out[
        0
    ][
        "mean"
    ]

    maximum_difference = max(

        abs(
            out[s][
                "mean"
            ]
            - rho0
        )

        for s in cfg.offsets
    )

    passed = (
        maximum_difference
        <= cfg.kernel_rho1_tolerance
    )

    return {

        "offsets":
            out,

        "rho0":
            rho0,

        "max_difference":
            maximum_difference,

        "passed":
            passed,
    }


