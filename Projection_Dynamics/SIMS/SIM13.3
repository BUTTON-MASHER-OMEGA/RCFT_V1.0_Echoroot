# ============================================================
# SIM13.3 — PHASE-SHIFTED TEMPORAL REPLAY PROBE
# ============================================================
#
# Scientific question
# -------------------
#
# Does native transverse restoring behavior depend specifically
# on synchronization between:
#
#     current non-Markovian memory M_t
#
# and
#
#     an otherwise temporally coherent kernel history K_t ?
#
#
# WHY THIS SIM EXISTS
# -------------------
#
# SIM13.2 IID replay approximately preserved the marginal
# distribution of kernel/operator values but destroyed:
#
#     1. memory-kernel synchronization
#     2. internal temporal ordering of the kernel sequence
#
# That produced kappa_decoupled ~ 1, consistent with loss of
# short-lag persistence rather than a genuine stronger spring.
#
#
# SIM13.3 therefore preserves a real contiguous native kernel
# trajectory:
#
#     K_s, K_{s+1}, K_{s+2}, ...
#
# while feeding it to a branch whose current memory state is:
#
#     M_0, M_1, M_2, ...
#
# Thus the replay retains native temporal ordering but is
# deliberately out of phase with the memory trajectory.
#
#
# PRIMARY:
#
#     Delta kappa
#       = kappa_native - kappa_shifted
#
#
# CRITICAL VALIDITY DIAGNOSTICS:
#
#     rho1(q_perp)
#     AR coefficient phi
#     kappa_AR = 1 - phi
#
# and temporal persistence of:
#
#     replay kernel sequence
#     LCO candidate sequence
#
#
# Desired control logic:
#
#   Native:
#       marginal kernel structure       preserved
#       kernel temporal structure       preserved
#       K_t <-> M_t synchronization     preserved
#
#   Shifted replay:
#       marginal kernel structure       preserved
#       kernel temporal structure       preserved
#       K_t <-> M_t synchronization     broken
#
#
# Fixed operating point:
#
#     beta   = 1.38
#     delta  = 0.95
#     lambda = 1.0
#     T_tol  = 1.0
#
#
# This is still a toy mechanistic intervention.
# It does NOT establish a physical autonomous LCO.
# ============================================================


import copy
import math
from collections import deque
from dataclasses import dataclass

import numpy as np


# ============================================================
# 1. C8 GRAPH / RCFT PROJECTION LABELING
# ============================================================

NBR = np.array(
    [
        [1, 2],  # 0
        [0, 3],  # 1
        [0, 4],  # 2
        [1, 5],  # 3
        [2, 6],  # 4
        [3, 7],  # 5
        [4, 7],  # 6
        [5, 6],  # 7
    ],
    dtype=np.int8,
)


PROJ = np.array(
    [0, 0, 1, 1, 2, 2, 3, 3],
    dtype=np.int8,
)


BASINS = np.array(
    [
        [0, 1],
        [2, 3],
        [4, 5],
        [6, 7],
    ],
    dtype=np.int8,
)


DP = (
    PROJ[NBR]
    != PROJ[:, None]
).astype(np.int8)


# ============================================================
# 2. CONFIGURATION
# ============================================================

@dataclass
class Config:

    lam: float = 1.0
    delta: float = 0.95
    beta: float = 1.38
    alpha: float = 1.0
    Ttol: float = 1.0

    burnin: int = 3000

    # Calibration must be long enough that we can extract a
    # contiguous replay window without repeating it.
    calibration: int = 14000

    reference: int = 4000
    observation: int = 6000

    # Temporal displacement between the calibration trajectory
    # and the replay window.
    replay_shift: int = 2000

    diagnostic_every: int = 5
    stats_window: int = 100

    fit_q_abs_max: float = 1.5
    min_bin_count: int = 40

    q_edges: tuple = (
        -3.0,
        -2.0,
        -1.5,
        -1.0,
        -0.5,
        0.0,
        0.5,
        1.0,
        1.5,
        2.0,
        3.0,
    )


CFG = Config()


# ============================================================
# 3. ISP KERNEL
# ============================================================

def p0_native(u, memory, cfg=CFG):

    m0 = math.tanh(
        float(memory[u, 0])
    )

    m1 = math.tanh(
        float(memory[u, 1])
    )


    delta_cost = (
        cfg.beta
        * float(
            DP[u, 0]
            - DP[u, 1]
        )
        - cfg.lam
        * (m0 - m1)
    )


    z = (
        delta_cost
        / cfg.Ttol
    )


    if z >= 0:

        ez = math.exp(-z)

        return (
            ez
            / (1.0 + ez)
        )


    ez = math.exp(z)

    return (
        1.0
        / (1.0 + ez)
    )


def all_native_probs(memory, cfg=CFG):

    probs = np.empty(
        (8, 2),
        dtype=float,
    )


    for u in range(8):

        p0 = p0_native(
            u,
            memory,
            cfg,
        )

        probs[u, 0] = p0
        probs[u, 1] = 1.0 - p0


    return probs


# ============================================================
# 4. MEMORY
# ============================================================

def update_memory(
    memory,
    u,
    slot,
    cfg=CFG,
):

    memory *= cfg.delta

    memory[
        u,
        slot,
    ] += 1.0


# ============================================================
# 5. COHERENCE–VALENCE STATE
#
# Z_x = (C_x, log V_eff,x)
# ============================================================

def compute_Z(
    hidden,
    obs,
    probs_all,
    cfg=CFG,
):

    hidden_arr = np.asarray(
        hidden,
        dtype=np.int8,
    )

    obs_arr = np.asarray(
        obs,
        dtype=np.int8,
    )


    src = hidden_arr[:-1].astype(
        np.int16
    )

    dst = hidden_arr[1:].astype(
        np.int16
    )


    basin_now = obs_arr[:-1].astype(
        np.int16
    )

    basin_next = obs_arr[1:].astype(
        np.int16
    )


    edge_counts = np.bincount(
        src * 8 + dst,
        minlength=64,
    ).reshape(
        8,
        8,
    )


    H_local = np.zeros(
        4,
        dtype=float,
    )

    P_local = np.zeros(
        4,
        dtype=float,
    )


    for x in range(4):

        basin_mask = (
            basin_now == x
        )


        if np.any(basin_mask):

            P_local[x] = float(
                np.mean(
                    basin_next[
                        basin_mask
                    ] == x
                )
            )


        entropies = []


        for u in BASINS[x]:

            c0 = edge_counts[
                u,
                NBR[u, 0],
            ]

            c1 = edge_counts[
                u,
                NBR[u, 1],
            ]


            total = c0 + c1


            if total <= 0:
                continue


            p0 = c0 / total
            p1 = c1 / total


            H = 0.0


            if p0 > 0:

                H -= (
                    p0
                    * math.log(p0)
                )


            if p1 > 0:

                H -= (
                    p1
                    * math.log(p1)
                )


            entropies.append(H)


        if entropies:

            H_local[x] = float(
                np.mean(entropies)
            )


    C_local = (
        -H_local
        + cfg.alpha
        * P_local
    )


    H_nodes = -np.sum(
        probs_all
        * np.log(
            probs_all
            + 1e-12
        ),
        axis=1,
    )


    V_nodes = np.exp(
        H_nodes
    )


    V_basin = np.mean(
        V_nodes[BASINS],
        axis=1,
    )


    logV = np.log(
        np.maximum(
            V_basin,
            1e-12,
        )
    )


    return np.column_stack(
        (
            C_local,
            logV,
        )
    )


# ============================================================
# 6. SIM13.1 CANDIDATE LOCAL OPERATOR
# ============================================================

def compute_L(
    probs_all,
    cfg=CFG,
):

    H_nodes = -np.sum(
        probs_all
        * np.log(
            probs_all
            + 1e-12
        ),
        axis=1,
    )


    same_projection = (
        PROJ[NBR]
        == PROJ[:, None]
    )


    P_nodes = np.sum(
        probs_all
        * same_projection,
        axis=1,
    )


    H_basin = np.mean(
        H_nodes[BASINS],
        axis=1,
    )


    P_basin = np.mean(
        P_nodes[BASINS],
        axis=1,
    )


    return (
        -H_basin
        + cfg.alpha
        * P_basin
    )


# ============================================================
# 7. SIMPLE NATIVE BURN-IN
# ============================================================

def run_plain_native(
    rng,
    state,
    memory,
    hidden,
    obs,
    steps,
    cfg=CFG,
):

    u = int(state)


    for _ in range(steps):

        p0 = p0_native(
            u,
            memory,
            cfg,
        )


        r = rng.random()


        slot = (
            0
            if r < p0
            else 1
        )


        v = int(
            NBR[
                u,
                slot,
            ]
        )


        update_memory(
            memory,
            u,
            slot,
            cfg,
        )


        hidden.append(v)

        obs.append(
            int(PROJ[v])
        )


        u = v


    return (
        u,
        memory,
        hidden,
        obs,
    )


# ============================================================
# 8. CONTIGUOUS NATIVE CALIBRATION TRAJECTORY
#
# IMPORTANT:
#
# Unlike SIM13.2, we store a kernel table EVERY microscopic
# transition.
#
# That means the replay sequence preserves native ordering at
# the same temporal resolution as the actual ISP dynamics.
# ============================================================

def run_calibration(
    rng,
    state,
    memory,
    hidden,
    obs,
    steps,
    cfg=CFG,
):

    u = int(state)


    kernel_sequence = np.empty(
        (
            steps,
            8,
            2,
        ),
        dtype=float,
    )


    L_sequence = np.empty(
        (
            steps,
            4,
        ),
        dtype=float,
    )


    for t in range(steps):

        probs_all = all_native_probs(
            memory,
            cfg,
        )


        kernel_sequence[t] = (
            probs_all
        )


        L_sequence[t] = compute_L(
            probs_all,
            cfg,
        )


        p0 = float(
            probs_all[
                u,
                0,
            ]
        )


        r = rng.random()


        slot = (
            0
            if r < p0
            else 1
        )


        v = int(
            NBR[
                u,
                slot,
            ]
        )


        update_memory(
            memory,
            u,
            slot,
            cfg,
        )


        hidden.append(v)

        obs.append(
            int(PROJ[v])
        )


        u = v


    return (
        u,
        memory,
        hidden,
        obs,
        kernel_sequence,
        L_sequence,
    )


# ============================================================
# 9. BRANCH RUNNER
# ============================================================

def run_branch(
    rng,
    state,
    memory,
    hidden,
    obs,
    replay_sequence,
    replay_start,
    steps,
    mode,
    cfg=CFG,
):

    if mode not in (
        "native",
        "shifted",
    ):

        raise ValueError(
            "mode must be 'native' or 'shifted'"
        )


    n_diag = (
        (steps - 1)
        // cfg.diagnostic_every
        + 1
    )


    Z_log = np.empty(
        (
            n_diag,
            4,
            2,
        ),
        dtype=float,
    )


    L_log = np.empty(
        (
            n_diag,
            4,
        ),
        dtype=float,
    )


    used_kernel_log = np.empty(
        (
            n_diag,
            8,
            2,
        ),
        dtype=float,
    )


    latent_kernel_log = np.empty(
        (
            n_diag,
            8,
            2,
        ),
        dtype=float,
    )


    TV_log = np.empty(
        n_diag,
        dtype=float,
    )


    KL_log = np.empty(
        n_diag,
        dtype=float,
    )


    u = int(state)

    d = 0


    for t in range(steps):

        latent_all = all_native_probs(
            memory,
            cfg,
        )


        if mode == "native":

            used_all = latent_all


        else:

            used_all = replay_sequence[
                replay_start
                + t
            ]


        p0 = float(
            used_all[
                u,
                0,
            ]
        )


        # Common random number stream between branches.
        r = rng.random()


        slot = (
            0
            if r < p0
            else 1
        )


        v = int(
            NBR[
                u,
                slot,
            ]
        )


        # Memory still evolves according to the realized branch
        # trajectory in BOTH conditions.
        update_memory(
            memory,
            u,
            slot,
            cfg,
        )


        hidden.append(v)

        obs.append(
            int(PROJ[v])
        )


        u = v


        if (
            t
            % cfg.diagnostic_every
            == 0
        ):

            Z_log[d] = compute_Z(
                hidden,
                obs,
                used_all,
                cfg,
            )


            L_log[d] = compute_L(
                used_all,
                cfg,
            )


            used_kernel_log[d] = (
                used_all
            )


            latent_kernel_log[d] = (
                latent_all
            )


            TV_log[d] = float(
                np.mean(
                    0.5
                    * np.sum(
                        np.abs(
                            latent_all
                            - used_all
                        ),
                        axis=1,
                    )
                )
            )


            KL_log[d] = float(
                np.mean(
                    np.sum(
                        latent_all
                        * np.log(
                            (
                                latent_all
                                + 1e-12
                            )
                            / (
                                used_all
                                + 1e-12
                            )
                        ),
                        axis=1,
                    )
                )
            )


            d += 1


    return (
        u,
        memory,
        hidden,
        obs,
        Z_log[:d],
        L_log[:d],
        used_kernel_log[:d],
        latent_kernel_log[:d],
        TV_log[:d],
        KL_log[:d],
    )


# ============================================================
# 10. PRINCIPAL-AXIS MANIFOLD
# ============================================================

def axes_from_reference(Z):

    Z = np.asarray(
        Z,
        dtype=float,
    )


    mu = np.mean(
        Z,
        axis=0,
    )


    centered = (
        Z - mu
    )


    cov = np.cov(
        centered.T
    )


    eigvals, eigvecs = np.linalg.eigh(
        cov
    )


    order = np.argsort(
        eigvals
    )[::-1]


    eigvals = eigvals[
        order
    ]


    eigvecs = eigvecs[
        :,
        order,
    ]


    e_parallel = eigvecs[
        :,
        0,
    ].copy()


    e_perp = eigvecs[
        :,
        1,
    ].copy()


    if e_parallel[0] < 0:

        e_parallel *= -1.0


    determinant = (
        e_parallel[0]
        * e_perp[1]
        - e_parallel[1]
        * e_perp[0]
    )


    if determinant < 0:

        e_perp *= -1.0


    lambda_parallel = max(
        float(eigvals[0]),
        1e-12,
    )


    lambda_perp = max(
        float(eigvals[1]),
        1e-12,
    )


    sigma_perp = math.sqrt(
        lambda_perp
    )


    anisotropy = (
        lambda_parallel
        / lambda_perp
    )


    return (
        mu,
        e_perp,
        sigma_perp,
        anisotropy,
    )


# ============================================================
# 11. BASIC CORRELATION HELPERS
# ============================================================

def safe_corr(x, y):

    x = np.asarray(
        x,
        dtype=float,
    )

    y = np.asarray(
        y,
        dtype=float,
    )


    mask = (
        np.isfinite(x)
        & np.isfinite(y)
    )


    x = x[mask]
    y = y[mask]


    if len(x) < 3:
        return np.nan


    sx = np.std(x)
    sy = np.std(y)


    if (
        sx < 1e-12
        or sy < 1e-12
    ):

        return np.nan


    return float(
        np.corrcoef(
            x,
            y,
        )[0, 1]
    )


def lag1_corr(x):

    x = np.asarray(
        x,
        dtype=float,
    )


    if len(x) < 3:
        return np.nan


    return safe_corr(
        x[:-1],
        x[1:],
    )


def kernel_lag1_corr(
    kernel_log,
):

    K = np.asarray(
        kernel_log,
        dtype=float,
    )


    if len(K) < 3:
        return np.nan


    a = K[:-1].reshape(
        -1
    )

    b = K[1:].reshape(
        -1
    )


    return safe_corr(
        a,
        b,
    )


# ============================================================
# 12. RESTORING FRACTION
# ============================================================

def restoring_fraction(
    q_now,
    dq,
    cfg=CFG,
):

    flags = []


    for i in range(
        len(cfg.q_edges) - 1
    ):

        lo = cfg.q_edges[i]
        hi = cfg.q_edges[i + 1]


        mask = (
            (q_now >= lo)
            & (q_now < hi)
        )


        if (
            int(np.sum(mask))
            < cfg.min_bin_count
        ):

            continue


        mean_q = float(
            np.mean(
                q_now[mask]
            )
        )


        mean_dq = float(
            np.mean(
                dq[mask]
            )
        )


        flags.append(
            mean_q
            * mean_dq
            < 0
        )


    if not flags:
        return np.nan


    return float(
        np.mean(flags)
    )


# ============================================================
# 13. BRANCH ANALYSIS
# ============================================================

def analyze_branch(
    Z_reference,
    Z_observation,
    L_observation,
    used_kernel_observation,
    TV_observation,
    KL_observation,
    cfg=CFG,
):

    out = {}


    for x in range(4):

        (
            mu,
            e_perp,
            sigma_perp,
            anisotropy,
        ) = axes_from_reference(
            Z_reference[
                :,
                x,
                :,
            ]
        )


        q = (
            (
                Z_observation[
                    :,
                    x,
                    :,
                ]
                - mu
            )
            @ e_perp
        ) / max(
            sigma_perp,
            1e-12,
        )


        q_now = q[:-1]
        q_next = q[1:]

        dq = (
            q_next
            - q_now
        )


        fit_mask = (
            np.isfinite(q_now)
            & np.isfinite(dq)
            & (
                np.abs(q_now)
                <= cfg.fit_q_abs_max
            )
        )


        q_fit = q_now[
            fit_mask
        ]

        dq_fit = dq[
            fit_mask
        ]

        q_next_fit = q_next[
            fit_mask
        ]


        # ----------------------------------------------------
        # Standard restoring regression:
        #
        # dq = slope*q + intercept
        # kappa = -slope
        # ----------------------------------------------------

        X = np.column_stack(
            (
                q_fit,
                np.ones(
                    len(q_fit)
                ),
            )
        )


        coef, _, _, _ = (
            np.linalg.lstsq(
                X,
                dq_fit,
                rcond=None,
            )
        )


        slope_dq = float(
            coef[0]
        )


        kappa = -slope_dq


        # ----------------------------------------------------
        # Equivalent AR-style fit:
        #
        # q_(t+1) = phi*q_t + b
        #
        # Since:
        #
        # dq = q_(t+1) - q_t
        #
        # we should have:
        #
        # kappa = 1 - phi
        #
        # on the SAME selected samples.
        # ----------------------------------------------------

        X_ar = np.column_stack(
            (
                q_fit,
                np.ones(
                    len(q_fit)
                ),
            )
        )


        coef_ar, _, _, _ = (
            np.linalg.lstsq(
                X_ar,
                q_next_fit,
                rcond=None,
            )
        )


        phi_fit = float(
            coef_ar[0]
        )


        kappa_from_phi = (
            1.0
            - phi_fit
        )


        rho1_q = lag1_corr(
            q
        )


        out[x] = {

            "kappa":
                kappa,

            "phi_fit":
                phi_fit,

            "kappa_from_phi":
                kappa_from_phi,

            "kappa_identity_error":
                abs(
                    kappa
                    - kappa_from_phi
                ),

            "rho1_q":
                rho1_q,

            "restore_fraction":
                restoring_fraction(
                    q_now,
                    dq,
                    cfg,
                ),

            "sigma_perp":
                sigma_perp,

            "anisotropy":
                anisotropy,

            "operator_mean":
                float(
                    np.mean(
                        L_observation[
                            :,
                            x,
                        ]
                    )
                ),

            "operator_std":
                float(
                    np.std(
                        L_observation[
                            :,
                            x,
                        ],
                        ddof=1,
                    )
                ),

            "operator_rho1":
                lag1_corr(
                    L_observation[
                        :,
                        x,
                    ]
                ),
        }


    out["kernel_rho1"] = (
        kernel_lag1_corr(
            used_kernel_observation
        )
    )


    out["mean_TV"] = float(
        np.mean(
            TV_observation
        )
    )


    out["mean_KL"] = float(
        np.mean(
            KL_observation
        )
    )


    return out


# ============================================================
# 14. ONE PAIRED SEED
# ============================================================

def simulate_seed(
    seed,
    cfg=CFG,
):

    rng = np.random.default_rng(
        seed
    )


    memory = np.zeros(
        (
            8,
            2,
        ),
        dtype=float,
    )


    hidden = deque(
        [0],
        maxlen=(
            cfg.stats_window
            + 1
        ),
    )


    obs = deque(
        [0],
        maxlen=(
            cfg.stats_window
            + 1
        ),
    )


    # --------------------------------------------------------
    # Burn-in
    # --------------------------------------------------------

    (
        state,
        memory,
        hidden,
        obs,
    ) = run_plain_native(
        rng,
        0,
        memory,
        hidden,
        obs,
        cfg.burnin,
        cfg,
    )


    # --------------------------------------------------------
    # Native calibration trajectory
    # --------------------------------------------------------

    (
        state,
        memory,
        hidden,
        obs,
        kernel_sequence,
        _L_cal,
    ) = run_calibration(
        rng,
        state,
        memory,
        hidden,
        obs,
        cfg.calibration,
        cfg,
    )


    total_branch_steps = (
        cfg.reference
        + cfg.observation
    )


    replay_start = (
        cfg.replay_shift
    )


    replay_end = (
        replay_start
        + total_branch_steps
    )


    if replay_end > len(
        kernel_sequence
    ):

        raise ValueError(
            "Calibration sequence too short "
            "for requested replay window."
        )


    # --------------------------------------------------------
    # Common branch point
    # --------------------------------------------------------

    split_rng_state = copy.deepcopy(
        rng.bit_generator.state
    )


    split_memory = (
        memory.copy()
    )


    split_hidden = deque(
        hidden,
        maxlen=hidden.maxlen,
    )


    split_obs = deque(
        obs,
        maxlen=obs.maxlen,
    )


    branches = {}


    for mode in (
        "native",
        "shifted",
    ):

        branch_rng = (
            np.random.default_rng()
        )


        branch_rng.bit_generator.state = (
            copy.deepcopy(
                split_rng_state
            )
        )


        branch_memory = (
            split_memory.copy()
        )


        branch_hidden = deque(
            split_hidden,
            maxlen=split_hidden.maxlen,
        )


        branch_obs = deque(
            split_obs,
            maxlen=split_obs.maxlen,
        )


        # ----------------------------------------------------
        # Reference
        # ----------------------------------------------------

        (
            branch_state,
            branch_memory,
            branch_hidden,
            branch_obs,
            Z_reference,
            _L_reference,
            _used_K_reference,
            _latent_K_reference,
            _TV_reference,
            _KL_reference,
        ) = run_branch(
            branch_rng,
            state,
            branch_memory,
            branch_hidden,
            branch_obs,
            kernel_sequence,
            replay_start,
            cfg.reference,
            mode,
            cfg,
        )


        # ----------------------------------------------------
        # Observation
        # ----------------------------------------------------

        (
            _,
            _,
            _,
            _,
            Z_observation,
            L_observation,
            used_K_observation,
            _latent_K_observation,
            TV_observation,
            KL_observation,
        ) = run_branch(
            branch_rng,
            branch_state,
            branch_memory,
            branch_hidden,
            branch_obs,
            kernel_sequence,
            (
                replay_start
                + cfg.reference
            ),
            cfg.observation,
            mode,
            cfg,
        )


        branches[
            mode
        ] = analyze_branch(
            Z_reference,
            Z_observation,
            L_observation,
            used_K_observation,
            TV_observation,
            KL_observation,
            cfg,
        )


    result = {}


    for x in range(4):

        N = branches[
            "native"
        ][x]


        S = branches[
            "shifted"
        ][x]


        result[x] = {

            "kappa_native":
                N["kappa"],

            "kappa_shifted":
                S["kappa"],

            "delta_kappa":
                (
                    N["kappa"]
                    - S["kappa"]
                ),

            "phi_native":
                N["phi_fit"],

            "phi_shifted":
                S["phi_fit"],

            "rho1_q_native":
                N["rho1_q"],

            "rho1_q_shifted":
                S["rho1_q"],

            "kappa_identity_error_native":
                N[
                    "kappa_identity_error"
                ],

            "kappa_identity_error_shifted":
                S[
                    "kappa_identity_error"
                ],

            "restore_native":
                N[
                    "restore_fraction"
                ],

            "restore_shifted":
                S[
                    "restore_fraction"
                ],

            "sigma_native":
                N["sigma_perp"],

            "sigma_shifted":
                S["sigma_perp"],

            "anisotropy_native":
                N["anisotropy"],

            "anisotropy_shifted":
                S["anisotropy"],

            "operator_mean_native":
                N["operator_mean"],

            "operator_mean_shifted":
                S["operator_mean"],

            "operator_std_native":
                N["operator_std"],

            "operator_std_shifted":
                S["operator_std"],

            "operator_rho1_native":
                N["operator_rho1"],

            "operator_rho1_shifted":
                S["operator_rho1"],
        }


    result["kernel_rho1_native"] = (
        branches[
            "native"
        ][
            "kernel_rho1"
        ]
    )


    result["kernel_rho1_shifted"] = (
        branches[
            "shifted"
        ][
            "kernel_rho1"
        ]
    )


    result["shifted_TV"] = (
        branches[
            "shifted"
        ][
            "mean_TV"
        ]
    )


    result["shifted_KL"] = (
        branches[
            "shifted"
        ][
            "mean_KL"
        ]
    )


    return result


