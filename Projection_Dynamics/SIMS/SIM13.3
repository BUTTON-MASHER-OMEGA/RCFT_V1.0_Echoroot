# 15. SUMMARY HELPERS
# ============================================================

def finite_array(values):

    arr = np.asarray(
        values,
        dtype=float,
    )

    return arr[
        np.isfinite(arr)
    ]


def mean_value(values):

    arr = finite_array(
        values
    )

    if len(arr) == 0:
        return np.nan

    return float(
        np.mean(arr)
    )


def median_value(values):

    arr = finite_array(
        values
    )

    if len(arr) == 0:
        return np.nan

    return float(
        np.median(arr)
    )


def iqr_value(values):

    arr = finite_array(
        values
    )

    if len(arr) == 0:
        return np.nan


    return float(
        np.quantile(
            arr,
            0.75,
        )
        - np.quantile(
            arr,
            0.25,
        )
    )


def fraction_positive(values):

    arr = finite_array(
        values
    )

    if len(arr) == 0:
        return np.nan


    return float(
        np.mean(
            arr > 0
        )
    )


