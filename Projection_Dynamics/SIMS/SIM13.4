
# ======================================================================
# SIM13.4 — TEMPORAL DISPLACEMENT / PHASE-RESPONSE MAP
# ======================================================================
#
# SCIENTIFIC QUESTION
# -------------------
#
# How does the local stochastic manifold respond to controlled temporal
# displacement between:
#
#     endogenous non-Markovian memory M_t
#
# and
#
#     an otherwise correctly ordered native transition-kernel history K_t ?
#
#
# ONLY INTERVENTION VARIABLE
# --------------------------
#
#     s = temporal displacement in microscopic ISP transitions
#
#
# Native reference trajectory:
#
#     K^N_0, K^N_1, K^N_2, ...
#
# Replay branch:
#
#     K_t^(s) = K^N_(t+s)
#
#
# IMPORTANT LANGUAGE
# ------------------
#
# s     = controlled temporal displacement
# TV/KL = observed relational mismatch
#
# Increasing s does NOT imply monotonically increasing mismatch.
#
#
# HARD CONTROL
# ------------
#
# A contemporaneous zero-displacement replay is generated from the
# exact same branch state and the exact same random-number stream:
#
#     K_t^(0) = K_t^N
#
# Therefore:
#
#     native ≈ replay(s=0)
#
# should hold essentially exactly.
#
# If it does not, replay itself is confounded and mechanistic
# interpretation stops.
#
#
# FIXED ARCHITECTURE
# ------------------
#
# beta   = 1.38
# delta  = 0.95
# lambda = 1.0
# T_tol  = 1.0
#
# C8 graph
# RCFT projection labeling
# same memory law
# same Z=(C, log V_eff) manifold construction
# same candidate LCO
# 50 seeds
#
#
# OFFSET GRID
# -----------
#
# Dense near zero because:
#
#     memory half-life = ln(1/2)/ln(0.95) ≈ 13.5 microsteps
#
# This is NOT assumed to be the phase-response timescale.
# It is merely an intrinsic toy-model timescale worth resolving.
#
#
# PRIMARY RESPONSE PACKAGE
# ------------------------
#
#     kappa_x(s)
#     sigma_perp,x(s)
#     anisotropy_x(s)
#
# Validation:
#
#     rho1(q_perp)
#     rho1(K)
#     rho1(L)
#     mean(L)
#     std(L)
#
# Mismatch:
#
#     TV_x(s)
#     KL_x(s)
#
#
# RESPONSE RELATIVE TO SYNCHRONIZATION
# ------------------------------------
#
#     Delta kappa_x(s) =
#         kappa_x(0) - kappa_x(s)
#
#     Delta sigma_x(s) =
#         sigma_x(s) - sigma_x(0)
#
#     Delta A_x(s) =
#         A_x(s) - A_x(0)
#
#
# BASIN CLASSES
# -------------
#
#     C_A = {0,3}
#     C_B = {1,2}
#
# Primary class contrast:
#
#     D_kappa(s)
#       = Delta kappa_A(s) - Delta kappa_B(s)
#
#
# SECONDARY MISMATCH-COLLAPSE QUESTION
# ------------------------------------
#
# Compare:
#
#     s -> G_x
#
# against
#
#     TV/KL -> G_x
#
# where
#
#     G_x = (kappa_x, sigma_perp,x, A_x)
#
#
# If comparable mismatch produces comparable geometry:
#
#     raw displacement may act mainly through relational mismatch.
#
# If comparable mismatch produces different geometry:
#
#     instantaneous mismatch is insufficient;
#     ordered history may retain additional information.
#
#
# INTERPRETIVE SAFEGUARD
# ----------------------
#
# Any apparent oscillation is candidate recurrence only.
# It is NOT evidence of a native frequency or resonance.
#
# ======================================================================


import math
from collections import deque
from dataclasses import dataclass

import numpy as np


# ======================================================================
# 1. GRAPH AND PROJECTION
# ======================================================================

NBR = np.array(
    [
        [1, 2],  # 0
        [0, 3],  # 1
        [0, 4],  # 2
        [1, 5],  # 3
        [2, 6],  # 4
        [3, 7],  # 5
        [4, 7],  # 6
        [5, 6],  # 7
    ],
    dtype=np.int8,
)

PROJ = np.array(
    [0, 0, 1, 1, 2, 2, 3, 3],
    dtype=np.int8,
)

BASINS = np.array(
    [
        [0, 1],
        [2, 3],
        [4, 5],
        [6, 7],
    ],
    dtype=np.int8,
)

DP = (
    PROJ[NBR]
    != PROJ[:, None]
).astype(np.float64)

SAME_PROJ = (
    PROJ[NBR]
    == PROJ[:, None]
)


# ======================================================================
# 2. CONFIGURATION
# ======================================================================

@dataclass
class Config:

    # Dynamics
    lam: float = 1.0
    delta: float = 0.95
    beta: float = 1.38
    alpha: float = 1.0
    Ttol: float = 1.0

    # Timeline
    burnin: int = 3000
    reference: int = 4000
    observation: int = 6000

    # Diagnostics
    diagnostic_every: int = 5
    stats_window: int = 100

    # Restoring-field fit
    fit_q_abs_max: float = 1.5
    min_bin_count: int = 40

    q_edges: tuple = (
        -3.0,
        -2.0,
        -1.5,
        -1.0,
        -0.5,
        0.0,
        0.5,
        1.0,
        1.5,
        2.0,
        3.0,
    )

    # Temporal displacement grid
    offsets: tuple = (
        0,
        1,
        2,
        4,
        8,
        12,
        16,
        25,
        50,
        100,
        250,
        500,
        1000,
        2000,
        4000,
    )

    # Validity gates
    replay_zero_tol: float = 1e-12

    # This is an empirical safeguard, not a theoretical constant.
    # Replay chronology is preserved by construction; this checks that
    # measured short-lag kernel persistence has not wandered grossly
    # across the sampled native windows.
    kernel_rho1_tolerance: float = 0.03


CFG = Config()


# ======================================================================
# 3. BASIC HELPERS
# ======================================================================

def stable_logistic_minus(z):
    """
    Returns 1/(1+exp(z)) stably.
    """

    z = np.asarray(z, dtype=float)

    out = np.empty_like(z)

    pos = z >= 0

    ez = np.exp(-z[pos])
    out[pos] = ez / (1.0 + ez)

    neg = ~pos

    ez = np.exp(z[neg])
    out[neg] = 1.0 / (1.0 + ez)

    return out


def finite_array(values):

    arr = np.asarray(values, dtype=float)

    return arr[np.isfinite(arr)]


def mean_value(values):

    arr = finite_array(values)

    return (
        float(np.mean(arr))
        if len(arr)
        else np.nan
    )


def median_value(values):

    arr = finite_array(values)

    return (
        float(np.median(arr))
        if len(arr)
        else np.nan
    )


def iqr_value(values):

    arr = finite_array(values)

    if len(arr) == 0:
        return np.nan

    return float(
        np.quantile(arr, 0.75)
        - np.quantile(arr, 0.25)
    )


def fraction_positive(values):

    arr = finite_array(values)

    if len(arr) == 0:
        return np.nan

    return float(np.mean(arr > 0))


def safe_corr(x, y):

    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)

    mask = (
        np.isfinite(x)
        & np.isfinite(y)
    )

    x = x[mask]
    y = y[mask]

    if len(x) < 3:
        return np.nan

    sx = np.std(x)
    sy = np.std(y)

    if sx < 1e-14 or sy < 1e-14:
        return np.nan

    return float(
        np.corrcoef(x, y)[0, 1]
    )


def lag1_corr(x):

    x = np.asarray(x, dtype=float)

    if len(x) < 3:
        return np.nan

    return safe_corr(
        x[:-1],
        x[1:],
    )


def kernel_lag1_corr(kernel_log):
    """
    Pooled lag-1 correlation across all kernel components.

    This preserves continuity with SIM13.3's diagnostic. It is a
    validation statistic, not a claimed physical observable.
    """

    K = np.asarray(kernel_log, dtype=float)

    if len(K) < 3:
        return np.nan

    return safe_corr(
        K[:-1].reshape(-1),
        K[1:].reshape(-1),
    )


# ======================================================================
# 4. ISP KERNEL
# ======================================================================

def all_native_probs(memory, cfg=CFG):
    """
    Vectorized current native kernel table.

    Shape:
        (8 states, 2 outgoing neighbors)
    """

    m = np.tanh(memory)

    projection_difference = (
        DP[:, 0]
        - DP[:, 1]
    )

    memory_difference = (
        m[:, 0]
        - m[:, 1]
    )

    delta_cost = (
        cfg.beta
        * projection_difference
        - cfg.lam
        * memory_difference
    )

    z = (
        delta_cost
        / cfg.Ttol
    )

    p0 = stable_logistic_minus(z)

    probs = np.empty(
        (8, 2),
        dtype=float,
    )

    probs[:, 0] = p0
    probs[:, 1] = 1.0 - p0

    return probs


# ======================================================================
# 5. MEMORY
# ======================================================================

def update_memory(
    memory,
    u,
    slot,
    cfg=CFG,
):

    memory *= cfg.delta

    memory[
        u,
        slot,
    ] += 1.0


# ======================================================================
# 6. SIM13.1 CANDIDATE LCO SIGNAL
# ======================================================================

def compute_L(
    probs_all,
    cfg=CFG,
):
    """
    L_x = -H_inst,x + alpha P_inst,x
    """

    probs_all = np.asarray(
        probs_all,
        dtype=float,
    )

    H_nodes = -np.sum(
        probs_all
        * np.log(
            probs_all
            + 1e-15
        ),
        axis=1,
    )

    P_nodes = np.sum(
        probs_all
        * SAME_PROJ,
        axis=1,
    )

    H_basin = np.mean(
        H_nodes[BASINS],
        axis=1,
    )

    P_basin = np.mean(
        P_nodes[BASINS],
        axis=1,
    )

    return (
        -H_basin
        + cfg.alpha
        * P_basin
    )


# ======================================================================
# 7. COHERENCE–VALENCE OBSERVABLE Z
# ======================================================================

def compute_Z(
    hidden,
    obs,
    probs_all,
    cfg=CFG,
):
    """
    Z_x = (C_x, log V_eff,x)

    C_x uses rolling empirical transition statistics.

    log V_eff uses the currently supplied transition kernel.
    """

    hidden_arr = np.asarray(
        hidden,
        dtype=np.int16,
    )

    obs_arr = np.asarray(
        obs,
        dtype=np.int16,
    )

    src = hidden_arr[:-1]
    dst = hidden_arr[1:]

    basin_now = obs_arr[:-1]
    basin_next = obs_arr[1:]

    edge_counts = np.bincount(
        src * 8 + dst,
        minlength=64,
    ).reshape(8, 8)

    H_local = np.zeros(
        4,
        dtype=float,
    )

    P_local = np.zeros(
        4,
        dtype=float,
    )

    for x in range(4):

        mask = (
            basin_now == x
        )

        if np.any(mask):

            P_local[x] = float(
                np.mean(
                    basin_next[mask]
                    == x
                )
            )

        entropies = []

        for u in BASINS[x]:

            c0 = edge_counts[
                u,
                NBR[u, 0],
            ]

            c1 = edge_counts[
                u,
                NBR[u, 1],
            ]

            total = c0 + c1

            if total <= 0:
                continue

            p0 = c0 / total
            p1 = c1 / total

            H = 0.0

            if p0 > 0:
                H -= p0 * math.log(p0)

            if p1 > 0:
                H -= p1 * math.log(p1)

            entropies.append(H)

        if entropies:

            H_local[x] = float(
                np.mean(entropies)
            )

    C_local = (
        -H_local
        + cfg.alpha
        * P_local
    )

    H_nodes = -np.sum(
        probs_all
        * np.log(
            probs_all
            + 1e-15
        ),
        axis=1,
    )

    V_nodes = np.exp(H_nodes)

    V_basin = np.mean(
        V_nodes[BASINS],
        axis=1,
    )

    logV = np.log(
        np.maximum(
            V_basin,
            1e-15,
        )
    )

    return np.column_stack(
        (
            C_local,
            logV,
        )
    )


# ======================================================================
# 8. BURN-IN
# ======================================================================

def run_burnin(
    rng,
    state,
    memory,
    hidden,
    obs,
    steps,
    cfg=CFG,
):

    u = int(state)

    for _ in range(steps):

        probs = all_native_probs(
            memory,
            cfg,
        )

        r = rng.random()

        slot = (
            0
            if r < probs[u, 0]
            else 1
        )

        v = int(
            NBR[u, slot]
        )

        update_memory(
            memory,
            u,
            slot,
            cfg,
        )

        hidden.append(v)
        obs.append(
            int(PROJ[v])
        )

        u = v

    return (
        u,
        memory,
        hidden,
        obs,
    )


# ======================================================================
# 9. DIAGNOSTIC LOG ALLOCATOR
# ======================================================================

def allocate_logs(
    total_branch_steps,
    cfg=CFG,
):

    n_diag = (
        (total_branch_steps - 1)
        // cfg.diagnostic_every
        + 1
    )

    return {
        "Z": np.empty(
            (n_diag, 4, 2),
            dtype=float,
        ),
        "L": np.empty(
            (n_diag, 4),
            dtype=float,
        ),
        "K": np.empty(
            (n_diag, 8, 2),
            dtype=float,
        ),
        "TV": np.empty(
            (n_diag, 4),
            dtype=float,
        ),
        "KL": np.empty(
            (n_diag, 4),
            dtype=float,
        ),
    }


# ======================================================================
# 10. BASIN-LOCAL KERNEL MISMATCH
# ======================================================================

def kernel_mismatch_by_basin(
    latent,
    used,
):
    """
    Basin-local TV and KL, averaged over the two hidden states
    belonging to each projection basin.
    """

    latent = np.asarray(
        latent,
        dtype=float,
    )

    used = np.asarray(
        used,
        dtype=float,
    )

    node_TV = (
        0.5
        * np.sum(
            np.abs(
                latent
                - used
            ),
            axis=1,
        )
    )

    node_KL = np.sum(
        latent
        * np.log(
            (
                latent
                + 1e-15
            )
            / (
                used
                + 1e-15
            )
        ),
        axis=1,
    )

    basin_TV = np.mean(
        node_TV[BASINS],
        axis=1,
    )

    basin_KL = np.mean(
        node_KL[BASINS],
        axis=1,
    )

    return (
        basin_TV,
        basin_KL,
    )


# ======================================================================
# 11. GENERATE CONTEMPORANEOUS NATIVE DRIVER
# ======================================================================

def generate_native_driver(
    state0,
    memory0,
    hidden0,
    obs0,
    uniforms,
    branch_steps,
    cfg=CFG,
):
    """
    Generates ONE native trajectory from the common branch point.

    Stores the native microscopic kernel sequence:

        K^N_0, K^N_1, ...

    for enough time to support every requested temporal displacement.

    The first `branch_steps` are also logged as the endogenous
    native comparison branch.
    """

    driver_steps = len(uniforms)

    u = int(state0)

    memory = memory0.copy()

    hidden = deque(
        hidden0,
        maxlen=hidden0.maxlen,
    )

    obs = deque(
        obs0,
        maxlen=obs0.maxlen,
    )

    K_sequence = np.empty(
        (
            driver_steps,
            8,
            2,
        ),
        dtype=float,
    )

    native_logs = allocate_logs(
        branch_steps,
        cfg,
    )

    native_path = np.empty(
        branch_steps + 1,
        dtype=np.int8,
    )

    native_path[0] = u

    d = 0

    for t in range(driver_steps):

        probs = all_native_probs(
            memory,
            cfg,
        )

        K_sequence[t] = probs

        r = uniforms[t]

        slot = (
            0
            if r < probs[u, 0]
            else 1
        )

        v = int(
            NBR[u, slot]
        )

        update_memory(
            memory,
            u,
            slot,
            cfg,
        )

        hidden.append(v)

        obs.append(
            int(PROJ[v])
        )

        u = v

        if t < branch_steps:

            native_path[
                t + 1
            ] = u

            if (
                t
                % cfg.diagnostic_every
                == 0
            ):

                native_logs["Z"][d] = (
                    compute_Z(
                        hidden,
                        obs,
                        probs,
                        cfg,
                    )
                )

                native_logs["L"][d] = (
                    compute_L(
                        probs,
                        cfg,
                    )
                )

                native_logs["K"][d] = (
                    probs
                )

                # Native latent == native used.
                native_logs["TV"][d] = 0.0
                native_logs["KL"][d] = 0.0

                d += 1

    for key in native_logs:

        native_logs[key] = (
            native_logs[key][:d]
        )

    return (
        K_sequence,
        native_logs,
        native_path,
    )


# ======================================================================
# 12. REPLAY ONE TEMPORAL OFFSET
# ======================================================================

def run_replay_offset(
    state0,
    memory0,
    hidden0,
    obs0,
    uniforms,
    K_native,
    offset,
    branch_steps,
    cfg=CFG,
):
    """
    Exogenous replay branch:

        K_t^(s) = K^N_(t+s)

    Memory still evolves according to the realized replay branch.
    """

    u = int(state0)

    memory = memory0.copy()

    hidden = deque(
        hidden0,
        maxlen=hidden0.maxlen,
    )

    obs = deque(
        obs0,
        maxlen=obs0.maxlen,
    )

    logs = allocate_logs(
        branch_steps,
        cfg,
    )

    path = np.empty(
        branch_steps + 1,
        dtype=np.int8,
    )

    path[0] = u

    d = 0

    for t in range(branch_steps):

        # Kernel the CURRENT replay memory would have generated.
        latent = all_native_probs(
            memory,
            cfg,
        )

        # Temporally displaced ordered kernel history.
        used = K_native[
            t + offset
        ]

        r = uniforms[t]

        slot = (
            0
            if r < used[u, 0]
            else 1
        )

        v = int(
            NBR[u, slot]
        )

        update_memory(
            memory,
            u,
            slot,
            cfg,
        )

        hidden.append(v)

        obs.append(
            int(PROJ[v])
        )

        u = v

        path[
            t + 1
        ] = u

        if (
            t
            % cfg.diagnostic_every
            == 0
        ):

            logs["Z"][d] = compute_Z(
                hidden,
                obs,
                used,
                cfg,
            )

            logs["L"][d] = compute_L(
                used,
                cfg,
            )

            logs["K"][d] = used

            (
                basin_TV,
                basin_KL,
            ) = kernel_mismatch_by_basin(
                latent,
                used,
            )

            logs["TV"][d] = (
                basin_TV
            )

            logs["KL"][d] = (
                basin_KL
            )

            d += 1

    for key in logs:

        logs[key] = (
            logs[key][:d]
        )

    return (
        logs,
        path,
    )


# ======================================================================
# 13. MANIFOLD AXES
# ======================================================================

def axes_from_reference(Z):

    Z = np.asarray(
        Z,
        dtype=float,
    )

    mu = np.mean(
        Z,
        axis=0,
    )

    centered = (
        Z - mu
    )

    cov = np.cov(
        centered.T
    )

    eigvals, eigvecs = np.linalg.eigh(
        cov
    )

    order = np.argsort(
        eigvals
    )[::-1]

    eigvals = eigvals[
        order
    ]

    eigvecs = eigvecs[
        :,
        order,
    ]

    e_parallel = eigvecs[
        :,
        0,
    ].copy()

    e_perp = eigvecs[
        :,
        1,
    ].copy()

    # Stable orientation convention.
    if e_parallel[0] < 0:

        e_parallel *= -1.0

    determinant = (
        e_parallel[0]
        * e_perp[1]
        - e_parallel[1]
        * e_perp[0]
    )

    if determinant < 0:

        e_perp *= -1.0

    lambda_parallel = max(
        float(eigvals[0]),
        1e-15,
    )

    lambda_perp = max(
        float(eigvals[1]),
        1e-15,
    )

    sigma_perp = math.sqrt(
        lambda_perp
    )

    anisotropy = (
        lambda_parallel
        / lambda_perp
    )

    return (
        mu,
        e_perp,
        sigma_perp,
        anisotropy,
    )


# ======================================================================
# 14. RESTORING FRACTION
# ======================================================================

def restoring_fraction(
    q_now,
    dq,
    cfg=CFG,
):

    flags = []

    for i in range(
        len(cfg.q_edges) - 1
    ):

        lo = cfg.q_edges[i]
        hi = cfg.q_edges[i + 1]

        mask = (
            (q_now >= lo)
            & (q_now < hi)
        )

        if (
            int(np.sum(mask))
            < cfg.min_bin_count
        ):
            continue

        mean_q = float(
            np.mean(
                q_now[mask]
            )
        )

        mean_dq = float(
            np.mean(
                dq[mask]
            )
        )

        flags.append(
            mean_q
            * mean_dq
            < 0
        )

    if not flags:
        return np.nan

    return float(
        np.mean(flags)
    )


# ======================================================================
# 15. SPLIT REFERENCE / OBSERVATION
# ======================================================================

def split_logs(
    logs,
    cfg=CFG,
):

    n_reference_diag = (
        (cfg.reference - 1)
        // cfg.diagnostic_every
        + 1
    )

    reference = {}
    observation = {}

    for key, arr in logs.items():

        reference[key] = (
            arr[
                :n_reference_diag
            ]
        )

        observation[key] = (
            arr[
                n_reference_diag:
            ]
        )

    return (
        reference,
        observation,
    )


# ======================================================================
# 16. ANALYZE ONE BRANCH
# ======================================================================

def analyze_logs(
    logs,
    cfg=CFG,
):

    (
        reference,
        observation,
    ) = split_logs(
        logs,
        cfg,
    )

    out = {}

    for x in range(4):

        (
            mu,
            e_perp,
            sigma_perp,
            anisotropy,
        ) = axes_from_reference(
            reference["Z"][
                :,
                x,
                :,
            ]
        )

        q = (
            (
                observation["Z"][
                    :,
                    x,
                    :,
                ]
                - mu
            )
            @ e_perp
        ) / max(
            sigma_perp,
            1e-15,
        )

        q_now = q[:-1]
        q_next = q[1:]

        dq = (
            q_next
            - q_now
        )

        fit_mask = (
            np.isfinite(q_now)
            & np.isfinite(dq)
            & (
                np.abs(q_now)
                <= cfg.fit_q_abs_max
            )
        )

        q_fit = q_now[
            fit_mask
        ]

        dq_fit = dq[
            fit_mask
        ]

        q_next_fit = q_next[
            fit_mask
        ]

        if len(q_fit) < 10:

            kappa = np.nan
            phi_fit = np.nan
            identity_error = np.nan

        else:

            X = np.column_stack(
                (
                    q_fit,
                    np.ones(
                        len(q_fit)
                    ),
                )
            )

            coef, _, _, _ = (
                np.linalg.lstsq(
                    X,
                    dq_fit,
                    rcond=None,
                )
            )

            kappa = -float(
                coef[0]
            )

            coef_ar, _, _, _ = (
                np.linalg.lstsq(
                    X,
                    q_next_fit,
                    rcond=None,
                )
            )

            phi_fit = float(
                coef_ar[0]
            )

            identity_error = abs(
                kappa
                - (
                    1.0
                    - phi_fit
                )
            )

        out[x] = {

            "kappa":
                kappa,

            "phi_fit":
                phi_fit,

            "kappa_identity_error":
                identity_error,

            "rho1_q":
                lag1_corr(q),

            "restore_fraction":
                restoring_fraction(
                    q_now,
                    dq,
                    cfg,
                ),

            "sigma_perp":
                sigma_perp,

            "anisotropy":
                anisotropy,

            "operator_mean":
                float(
                    np.mean(
                        observation["L"][
                            :,
                            x,
                        ]
                    )
                ),

            "operator_std":
                float(
                    np.std(
                        observation["L"][
                            :,
                            x,
                        ],
                        ddof=1,
                    )
                ),

            "operator_rho1":
                lag1_corr(
                    observation["L"][
                        :,
                        x,
                    ]
                ),

            "TV":
                float(
                    np.mean(
                        observation["TV"][
                            :,
                            x,
                        ]
                    )
                ),

            "KL":
                float(
                    np.mean(
                        observation["KL"][
                            :,
                            x,
                        ]
                    )
                ),
        }

    out["kernel_rho1"] = (
        kernel_lag1_corr(
            observation["K"]
        )
    )

    out["global_TV"] = float(
        np.mean(
            observation["TV"]
        )
    )

    out["global_KL"] = float(
        np.mean(
            observation["KL"]
        )
    )

    return out


# ======================================================================
# 17. HARD s=0 REPLAY VALIDATION
# ======================================================================

def validate_zero_replay(
    native_logs,
    native_path,
    replay_logs,
    replay_path,
    cfg=CFG,
):

    path_equal = np.array_equal(
        native_path,
        replay_path,
    )

    differences = {}

    for key in (
        "Z",
        "L",
        "K",
        "TV",
        "KL",
    ):

        differences[key] = float(
            np.max(
                np.abs(
                    native_logs[key]
                    - replay_logs[key]
                )
            )
        )

    max_difference = max(
        differences.values()
    )

    passed = (
        path_equal
        and max_difference
        <= cfg.replay_zero_tol
    )

    return {
        "passed":
            passed,

        "path_equal":
            path_equal,

        "max_difference":
            max_difference,

        "differences":
            differences,
    }


# ======================================================================
# 18. ONE FULL PAIRED SEED
# ======================================================================

def simulate_seed(
    seed,
    cfg=CFG,
):

    rng = np.random.default_rng(
        seed
    )

    memory = np.zeros(
        (8, 2),
        dtype=float,
    )

    hidden = deque(
        [0],
        maxlen=(
            cfg.stats_window
            + 1
        ),
    )

    obs = deque(
        [0],
        maxlen=(
            cfg.stats_window
            + 1
        ),
    )

    # ------------------------------------------------------
    # Burn-in
    # ------------------------------------------------------

    (
        state0,
        memory0,
        hidden0,
        obs0,
    ) = run_burnin(
        rng,
        0,
        memory,
        hidden,
        obs,
        cfg.burnin,
        cfg,
    )

    # ------------------------------------------------------
    # Freeze common branch point
    # ------------------------------------------------------

    memory_start = (
        memory0.copy()
    )

    hidden_start = deque(
        hidden0,
        maxlen=hidden0.maxlen,
    )

    obs_start = deque(
        obs0,
        maxlen=obs0.maxlen,
    )

    branch_steps = (
        cfg.reference
        + cfg.observation
    )

    max_offset = max(
        cfg.offsets
    )

    driver_steps = (
        branch_steps
        + max_offset
    )

    # One CRN stream shared by native and every replay branch.
    uniforms = rng.random(
        driver_steps
    )

    # ------------------------------------------------------
    # Generate contemporaneous native kernel history
    # ------------------------------------------------------

    (
        K_native,
        native_logs,
        native_path,
    ) = generate_native_driver(
        state0,
        memory_start,
        hidden_start,
        obs_start,
        uniforms,
        branch_steps,
        cfg,
    )

    native_metrics = analyze_logs(
        native_logs,
        cfg,
    )

    # ------------------------------------------------------
    # Explicit s=0 replay
    # ------------------------------------------------------

    (
        replay0_logs,
        replay0_path,
    ) = run_replay_offset(
        state0,
        memory_start,
        hidden_start,
        obs_start,
        uniforms,
        K_native,
        0,
        branch_steps,
        cfg,
    )

    zero_validation = (
        validate_zero_replay(
            native_logs,
            native_path,
            replay0_logs,
            replay0_path,
            cfg,
        )
    )

    if not zero_validation[
        "passed"
    ]:

        raise RuntimeError(
            "\nSIM13.4 HARD CONTROL FAILURE\n"
            f"Seed: {seed}\n"
            "Native != contemporaneous replay(s=0).\n"
            f"Path equal: "
            f"{zero_validation['path_equal']}\n"
            f"Max difference: "
            f"{zero_validation['max_difference']:.3e}\n"
            "Mechanistic interpretation must stop."
        )

    # ------------------------------------------------------
    # All temporal displacements
    # ------------------------------------------------------

    offset_results = {}

    for s in cfg.offsets:

        if s == 0:

            logs = replay0_logs

        else:

            (
                logs,
                _
            ) = run_replay_offset(
                state0,
                memory_start,
                hidden_start,
                obs_start,
                uniforms,
                K_native,
                s,
                branch_steps,
                cfg,
            )

        offset_results[s] = (
            analyze_logs(
                logs,
                cfg,
            )
        )

    return {
        "seed":
            seed,

        "native":
            native_metrics,

        "offsets":
            offset_results,

        "zero_validation":
            zero_validation,
    }


