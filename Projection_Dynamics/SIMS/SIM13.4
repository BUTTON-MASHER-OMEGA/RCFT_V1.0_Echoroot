def summarize_results(
    runs,
    cfg=CFG,
):

    summaries = {
        x: {}
        for x in range(4)
    }

    for x in range(4):

        for s in cfg.offsets:

            rows = [
                run["offsets"][s][x]
                for run in runs
            ]

            baseline_rows = [
                run["offsets"][0][x]
                for run in runs
            ]

            kappas = np.asarray(
                [
                    r["kappa"]
                    for r in rows
                ],
                dtype=float,
            )

            kappa0 = np.asarray(
                [
                    r["kappa"]
                    for r in baseline_rows
                ],
                dtype=float,
            )

            sigmas = np.asarray(
                [
                    r["sigma_perp"]
                    for r in rows
                ],
                dtype=float,
            )

            sigma0 = np.asarray(
                [
                    r["sigma_perp"]
                    for r in baseline_rows
                ],
                dtype=float,
            )

            anis = np.asarray(
                [
                    r["anisotropy"]
                    for r in rows
                ],
                dtype=float,
            )

            anis0 = np.asarray(
                [
                    r["anisotropy"]
                    for r in baseline_rows
                ],
                dtype=float,
            )

            delta_kappa = (
                kappa0 - kappas
            )

            delta_sigma = (
                sigmas - sigma0
            )

            delta_anis = (
                anis - anis0
            )

            summaries[x][s] = {

                "kappa_mean":
                    mean_value(kappas),

                "kappa_med":
                    median_value(kappas),

                "delta_kappa_mean":
                    mean_value(
                        delta_kappa
                    ),

                "delta_kappa_med":
                    median_value(
                        delta_kappa
                    ),

                "delta_kappa_IQR":
                    iqr_value(
                        delta_kappa
                    ),

                "P_delta_kappa_positive":
                    fraction_positive(
                        delta_kappa
                    ),

                "sigma_mean":
                    mean_value(sigmas),

                "sigma_med":
                    median_value(sigmas),

                "delta_sigma_med":
                    median_value(
                        delta_sigma
                    ),

                "anis_mean":
                    mean_value(anis),

                "anis_med":
                    median_value(anis),

                "delta_anis_med":
                    median_value(
                        delta_anis
                    ),

                "rho1_q_mean":
                    mean_value(
                        [
                            r["rho1_q"]
                            for r in rows
                        ]
                    ),

                "restore_mean":
                    mean_value(
                        [
                            r[
                                "restore_fraction"
                            ]
                            for r in rows
                        ]
                    ),

                "L_mean":
                    mean_value(
                        [
                            r[
                                "operator_mean"
                            ]
                            for r in rows
                        ]
                    ),

                "L_std":
                    mean_value(
                        [
                            r[
                                "operator_std"
                            ]
                            for r in rows
                        ]
                    ),

                "L_rho1":
                    mean_value(
                        [
                            r[
                                "operator_rho1"
                            ]
                            for r in rows
                        ]
                    ),

                "TV_med":
                    median_value(
                        [
                            r["TV"]
                            for r in rows
                        ]
                    ),

                "KL_med":
                    median_value(
                        [
                            r["KL"]
                            for r in rows
                        ]
                    ),

                "identity_error_mean":
                    mean_value(
                        [
                            r[
                                "kappa_identity_error"
                            ]
                            for r in rows
                        ]
                    ),
            }

    return summaries


# ======================================================================
# 20. PAIR-CLASS RESPONSE
# ======================================================================

def summarize_pair_classes(
    runs,
    cfg=CFG,
):

    out = {}

    for s in cfg.offsets:

        outer_delta = []
        inner_delta = []
        class_difference = []

        for run in runs:

            baseline = (
                run["offsets"][0]
            )

            current = (
                run["offsets"][s]
            )

            dk = {}

            for x in range(4):

                dk[x] = (
                    baseline[x]["kappa"]
                    - current[x]["kappa"]
                )

            outer = 0.5 * (
                dk[0]
                + dk[3]
            )

            inner = 0.5 * (
                dk[1]
                + dk[2]
            )

            outer_delta.append(
                outer
            )

            inner_delta.append(
                inner
            )

            class_difference.append(
                outer - inner
            )

        out[s] = {

            "outer_med":
                median_value(
                    outer_delta
                ),

            "inner_med":
                median_value(
                    inner_delta
                ),

            "D_kappa_med":
                median_value(
                    class_difference
                ),

            "P_outer_positive":
                fraction_positive(
                    outer_delta
                ),

            "P_inner_positive":
                fraction_positive(
                    inner_delta
                ),

            "P_D_positive":
                fraction_positive(
                    class_difference
                ),
        }

    return out


# ======================================================================
# 21. KERNEL CHRONOLOGY SUMMARY
# ======================================================================

def chronology_summary(
    runs,
    cfg=CFG,
):

    out = {}

    for s in cfg.offsets:

        values = [
            run[
                "offsets"
            ][s][
                "kernel_rho1"
            ]
            for run in runs
        ]

        out[s] = {
            "mean":
                mean_value(values),

            "median":
                median_value(values),
        }

    rho0 = out[0][
        "mean"
    ]

    maximum_difference = 0.0

    for s in cfg.offsets:

        difference = abs(
            out[s]["mean"]
            - rho0
        )

        maximum_difference = max(
            maximum_difference,
            difference,
        )

    passed = (
        maximum_difference
        <= cfg.kernel_rho1_tolerance
    )

    return {
        "offsets":
            out,

        "rho0":
            rho0,

        "max_difference":
            maximum_difference,

        "passed":
            passed,
    }


# ======================================================================
# 22. EXPLORATORY MISMATCH-COLLAPSE PAIRS
# ======================================================================

def mismatch_collapse_pairs(
    summaries,
    basin,
    cfg=CFG,
    top_n=6,
):
    """
    Exploratory only.

    Finds offset pairs that have similar median TV mismatch despite
    substantially different temporal displacement.

    Then reports how different their manifold responses are.

    No fitted compatibility parameter is introduced.
    """

    offsets = [
        s
        for s in cfg.offsets
        if s > 0
    ]

    rows = []

    # Robust scales only for reporting a dimensionless geometry distance.
    delta_k = np.array(
        [
            summaries[basin][s][
                "delta_kappa_med"
            ]
            for s in offsets
        ],
        dtype=float,
    )

    delta_sigma = np.array(
        [
            summaries[basin][s][
                "delta_sigma_med"
            ]
            for s in offsets
        ],
        dtype=float,
    )

    delta_A = np.array(
        [
            summaries[basin][s][
                "delta_anis_med"
            ]
            for s in offsets
        ],
        dtype=float,
    )

    def robust_scale(x):

        scale = (
            np.quantile(x, 0.75)
            - np.quantile(x, 0.25)
        )

        if abs(scale) < 1e-12:

            scale = np.std(x)

        if abs(scale) < 1e-12:

            scale = 1.0

        return float(scale)

    scale_k = robust_scale(
        delta_k
    )

    scale_sigma = robust_scale(
        delta_sigma
    )

    scale_A = robust_scale(
        delta_A
    )

    for i in range(
        len(offsets)
    ):

        for j in range(
            i + 1,
            len(offsets)
        ):

            s1 = offsets[i]
            s2 = offsets[j]

            # Require meaningfully separated temporal offsets.
            if abs(s2 - s1) < 8:
                continue

            r1 = summaries[
                basin
            ][s1]

            r2 = summaries[
                basin
            ][s2]

            tv_gap = abs(
                r1["TV_med"]
                - r2["TV_med"]
            )

            kl_gap = abs(
                r1["KL_med"]
                - r2["KL_med"]
            )

            geometry_distance = math.sqrt(
                (
                    (
                        r1[
                            "delta_kappa_med"
                        ]
                        - r2[
                            "delta_kappa_med"
                        ]
                    )
                    / scale_k
                ) ** 2
                +
                (
                    (
                        r1[
                            "delta_sigma_med"
                        ]
                        - r2[
                            "delta_sigma_med"
                        ]
                    )
                    / scale_sigma
                ) ** 2
                +
                (
                    (
                        r1[
                            "delta_anis_med"
                        ]
                        - r2[
                            "delta_anis_med"
                        ]
                    )
                    / scale_A
                ) ** 2
            )

            rows.append(
                {
                    "s1":
                        s1,

                    "s2":
                        s2,

                    "TV_gap":
                        tv_gap,

                    "KL_gap":
                        kl_gap,

                    "geometry_distance":
                        geometry_distance,
                }
            )

    rows.sort(
        key=lambda r: (
            r["TV_gap"],
            r["KL_gap"],
        )
    )

    return rows[
        :top_n
    ]


