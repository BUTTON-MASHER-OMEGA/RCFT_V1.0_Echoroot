        cfg.offsets
    )

    print()

    print(
        "s = controlled temporal displacement"
    )

    print(
        "TV/KL = observed relational mismatch"
    )

    print()

    print(
        "HARD CONTROL:"
    )

    print(
        "native must equal contemporaneous replay(s=0)"
    )

    print()


    runs = []

    zero_max_differences = []


    for seed in range(
        1,
        n_seeds + 1,
    ):

        result = simulate_seed(
            seed,
            cfg,
        )

        runs.append(
            result
        )

        zero_max_differences.append(
            result[
                "zero_validation"
            ][
                "max_difference"
            ]
        )

        print(
            f"completed seed "
            f"{seed:3d}/{n_seeds}"
        )


    # ======================================================
    # HARD ZERO-REPLAY GATE
    # ======================================================

    zero_gate_passed = all(
        run[
            "zero_validation"
        ][
            "passed"
        ]
        for run in runs
    )

    print()

    print(
        "=" * 88
    )

    print(
