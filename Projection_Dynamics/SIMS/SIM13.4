def run_SIM13_4(
    n_seeds=50,
    cfg=CFG,
):

    memory_half_life = (
        math.log(0.5)
        / math.log(
            cfg.delta
        )
    )

    branch_steps = (
        cfg.reference
        + cfg.observation
    )

    driver_steps = (
        branch_steps
        + max(cfg.offsets)
    )

    print()

    print(
        "=" * 88
    )

    print(
        "SIM13.4 — TEMPORAL DISPLACEMENT / PHASE-RESPONSE MAP"
    )

    print(
        "=" * 88
    )

    print(
        f"beta={cfg.beta}, "
        f"delta={cfg.delta}, "
        f"lambda={cfg.lam}, "
        f"T_tol={cfg.Ttol}"
    )

    print(
        f"Memory half-life from delta: "
        f"{memory_half_life:.4f} microscopic steps"
    )

    print(
        f"Reference steps : "
